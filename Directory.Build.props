<Project>
  <!-- Общие настройки для всех проектов решения. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.5.1</Version>
    <Product>PC Toolkit</Product>
    <Company>PC Toolkit</Company>
    <Copyright>PC Toolkit contributors</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!--
      Не помечать PcToolkit.exe и службу как совместимые с CET (аппаратный теневой стек).
      Иначе на процессорах с CET (AMD Zen 3 и новее, Intel 11-го поколения и новее) и Windows 10
      без последних обновлений (нет функции QueueUserAPC2) среда .NET падает сразу при запуске:
      «Your Windows doesn't fully support CET» (в журнале событий — .NET Runtime 1023, код 0x80131506).
    -->
    <CETCompat>false</CETCompat>
    <!--
      Репозиторий проекта на GitHub: «владелец/имя». Из него программа берёт новые версии (выпуски) и файл
      pctoolkit.json с адресом сервера общего рейтинга. Пусто — автообновление и рейтинг выключены.
    -->
    <GitHubRepo>alexamdrishe-cyber/pc-toolkit</GitHubRepo>
    <!--
      Свой адрес обновлений вместо выпусков GitHub: файл update.json (version, url, sha256, notes)
      или https://api.github.com/repos/ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ/releases/latest. Обычно пусто.
    -->
    <UpdateUrl></UpdateUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
  </ItemGroup>
</Project>
