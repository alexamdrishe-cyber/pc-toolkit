<Project>
  <!-- Общие настройки для всех проектов решения. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.0</Version>
    <Product>PC Toolkit</Product>
    <Company>PC Toolkit</Company>
    <Copyright>PC Toolkit contributors</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!--
      Не помечать PcToolkit.exe и службу как совместимые с CET (аппаратный теневой стек).
      Иначе на процессорах с CET (AMD Zen 3 и новее, Intel 11-го поколения и новее) и Windows 10
      без последних обновлений (нет функции QueueUserAPC2) среда .NET падает сразу при запуске:
      «Your Windows doesn't fully support CET» (в журнале событий — .NET Runtime 1023, код 0x80131506).
    -->
    <CETCompat>false</CETCompat>
    <!--
      Откуда программа узнаёт о новых версиях: файл update.json (version, url, sha256, notes) или
      https://api.github.com/repos/ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ/releases/latest. Пусто — автообновление выключено.
    -->
    <UpdateUrl></UpdateUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
  </ItemGroup>
</Project>
