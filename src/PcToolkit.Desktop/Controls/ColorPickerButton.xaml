<UserControl x:Class="PcToolkit.Desktop.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <!-- Кнопка-образец: щелчок открывает палитру -->
        <Button x:Name="Toggle" Click="OnToggle" Cursor="Hand" FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Width="38" Height="26" CornerRadius="6" BorderThickness="1" Padding="3"
                            BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource InputBrush}">
                        <Border CornerRadius="3" Background="{Binding SwatchBrush, ElementName=Root}"
                                BorderBrush="#33FFFFFF" BorderThickness="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SearchHoverLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="Palette" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="OnPopupClosed" Opened="OnPopupOpened">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,4,0,0">
                <StackPanel Width="206">
                    <ItemsControl x:Name="Swatches" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnSwatch" Tag="{Binding}" Cursor="Hand" Margin="0,0,5,5" FocusVisualStyle="{x:Null}" ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Width="36" Height="22" CornerRadius="4" Background="{Binding}"
                                                    BorderBrush="#40FFFFFF" BorderThickness="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Hex" Style="{StaticResource SearchBox}" Height="28" FontSize="12.5" Tag="#RRGGBB"
                                 KeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus" />
                        <Button x:Name="Reset" Grid.Column="1" Content="Обычный" Style="{StaticResource GhostButton}" Padding="8,2"
                                Margin="6,0,0,0" Click="OnReset" ToolTip="Вернуть цвет по умолчанию" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
