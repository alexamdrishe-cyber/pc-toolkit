<UserControl x:Class="PcToolkit.Desktop.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls">

    <UserControl.Resources>

        <!-- Метка рекомендации: «Можно удалить», «Лучше оставить»… -->
        <Style x:Key="AdviceBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AdviceKind}" Value="good">
                    <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AdviceKind}" Value="info">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AdviceKind}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AdviceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AdviceKind}" Value="good">
                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AdviceKind}" Value="info">
                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AdviceKind}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Приложения" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Удаление программ и приложений Microsoft Store. После деинсталлятора PC Toolkit найдёт оставшиеся папки, ярлыки, записи реестра, автозапуск и задания — удаляется только то, что вы отметите, с возможностью вернуть. «Остатки удалённых программ» найдут то же от программ, удалённых раньше." />
        </StackPanel>

        <!-- Поиск, фильтры, сортировка -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="300" Style="{StaticResource SearchBox}" Tag="Поиск по названию или издателю"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton Content="{Binding AllCaption}" GroupName="apps-filter" Style="{StaticResource TabRadio}" Margin="12,0,0,0"
                             IsChecked="{Binding FilterAll, Mode=TwoWay}" />
                <RadioButton Content="{Binding DesktopCaption}" GroupName="apps-filter" Style="{StaticResource TabRadio}" Margin="6,0,0,0"
                             IsChecked="{Binding FilterDesktop, Mode=TwoWay}" />
                <RadioButton Content="{Binding StoreCaption}" GroupName="apps-filter" Style="{StaticResource TabRadio}" Margin="6,0,0,0"
                             IsChecked="{Binding FilterStore, Mode=TwoWay}" />
                <RadioButton Content="{Binding RecommendedCaption}" GroupName="apps-filter" Style="{StaticResource TabRadio}" Margin="6,0,0,0"
                             IsChecked="{Binding FilterRecommended, Mode=TwoWay}"
                             ToolTip="Предустановленные приложения Windows, которые обычно не нужны: реклама, игры, сервисы Microsoft" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Остатки удалённых программ" Command="{Binding FindOrphansCommand}" Style="{StaticResource GhostButton}"
                        ToolTip="Ярлыки, автозапуск и задания, которые ведут на удалённые файлы, записи без программ и пустые папки" />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="СОРТИРОВКА" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton Content="По имени" GroupName="apps-sort" Style="{StaticResource TabRadio}" IsChecked="{Binding SortByName, Mode=TwoWay}" />
                <RadioButton Content="По размеру" GroupName="apps-sort" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding SortBySize, Mode=TwoWay}" />
                <RadioButton Content="По дате установки" GroupName="apps-sort" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding SortByDate, Mode=TwoWay}" />
            </StackPanel>
            <Button Content="Отметить всё, что можно удалить" Command="{Binding SelectRecommendedCommand}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    ToolTip="Отметить предустановленные приложения с пометкой «Можно удалить»" />
        </Grid>

        <!-- Сообщения и удалённые приложения Store -->
        <StackPanel Grid.Row="3">
            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoLineBrush}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                    Visibility="{Binding HasRemovedApps, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Удалённые приложения Microsoft Store" FontWeight="SemiBold" />
                    <TextBlock Text="Их можно вернуть: PC Toolkit переустановит приложение или откроет его страницу в магазине."
                               Style="{StaticResource MutedCaption}" Margin="0,2,0,6" />
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding RemovedApps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedCaption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="Вернуть" Command="{Binding RestoreCommand}" Style="{StaticResource GhostButton}"
                                                Padding="10,3" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Список -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0" controls:PageScroll.FillHeight="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,10,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ПРИЛОЖЕНИЕ" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="3" Text="УСТАНОВЛЕНО" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="РАЗМЕР" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Grid.Row="1" Text="Собираю список приложений…" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Row="1" Text="Ничего не найдено." Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleApps}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanUninstall}" VerticalAlignment="Center" />

                                    <Grid Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border CornerRadius="8" Background="{DynamicResource ControlBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="&#xECAA;" Style="{StaticResource Icon}" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AdviceNote}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding AdviceNote}"
                                                   Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="Деинсталлятор не найден — можно убрать запись и следы" FontSize="11.5"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding UninstallerMissing, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Style="{StaticResource AdviceBadge}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            ToolTip="{Binding AdviceNote}"
                                            Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AdviceText}" Style="{StaticResource AdviceText}" />
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="6" Content="Удалить" Command="{Binding UninstallCommand}" Style="{StaticResource GhostButton}"
                                            Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Выбранные -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Снять выбор" Command="{Binding ClearSelectionCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="Удалить выбранные" Command="{Binding UninstallSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
