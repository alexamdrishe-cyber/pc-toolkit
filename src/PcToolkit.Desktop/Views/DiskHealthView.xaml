<UserControl x:Class="PcToolkit.Desktop.Views.DiskHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls"
             xmlns:services="clr-namespace:PcToolkit.Desktop.Services">

    <UserControl.Resources>
        <!-- Показатель: цветная точка, название, что это, чем грозит и что делать; справа значение. -->
        <DataTemplate x:Key="HealthItemTemplate">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Fill="{DynamicResource TextMutedBrush}" />
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding What}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding RiskText}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"
                                   Visibility="{Binding RiskText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="19" FontWeight="SemiBold"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Top" TextAlignment="Right" MaxWidth="340" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource InfoBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка таблицы SMART диска SATA: номер, название, текущее, худшее, порог, «сырое» значение. -->
        <DataTemplate x:Key="AtaRowTemplate">
            <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Grid.Column="2" Text="{Binding Current}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding Worst}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{Binding Threshold}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="Raw" Grid.Column="5" Text="{Binding Raw}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                    <Setter TargetName="Raw" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Raw" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Raw" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка журнала здоровья NVMe: название и значение. -->
        <DataTemplate x:Key="NvmeRowTemplate">
            <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Raw" Grid.Column="1" Text="{Binding Raw}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Raw" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Raw" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка диска. -->
        <DataTemplate x:Key="DiskCardTemplate">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconCircle" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                                Background="{DynamicResource ControlBrush}">
                            <controls:IconView x:Name="Icon" Width="20" Height="20" StrokeThickness="2"
                                               Icon="{x:Static services:Icons.Disk}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border x:Name="Pill" Grid.Column="2" CornerRadius="10" Padding="10,4" VerticalAlignment="Center"
                                Background="{DynamicResource ControlBrush}">
                            <TextBlock x:Name="PillText" Text="{Binding VerdictText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="54,10,0,0" />

                    <ItemsControl ItemsSource="{Binding Stats}" Margin="54,12,0,0" Focusable="False"
                                  Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,10,6" MinWidth="110">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedCaption}" />
                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource HealthItemTemplate}" Margin="54,8,0,0"
                                  Focusable="False" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />

                    <Grid Margin="54,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding IdentityText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityText}" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="{Binding TableButtonText}" Command="{Binding ToggleTableCommand}"
                                Style="{StaticResource GhostButton}" Padding="10,4"
                                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Подробная таблица SMART -->
                    <StackPanel Margin="54,12,0,0" Visibility="{Binding ShowTable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Visibility="{Binding RowsHaveThresholds, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ID" Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="1" Text="АТРИБУТ" Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="2" Text="ТЕКУЩЕЕ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="ХУДШЕЕ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="ПОРОГ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="ЗНАЧЕНИЕ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AtaRowTemplate}" Focusable="False" />
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="«Текущее» и «худшее» — оценки самого диска (обычно 100–253, чем больше, тем лучше). Если текущее опускается до порога, диск считает себя неисправным. «Значение» — счётчик: часы, ошибки, секторы — смотря какой атрибут." />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource NvmeRowTemplate}" Focusable="False"
                                      Visibility="{Binding RowsHaveThresholds, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="Good">
                    <Setter TargetName="IconCircle" Property="Background" Value="{DynamicResource GoodChipBrush}" />
                    <Setter TargetName="Icon" Property="Icon" Value="{x:Static services:Icons.Check}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource GoodChipBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource GoodTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Warning">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                    <Setter TargetName="IconCircle" Property="Background" Value="{DynamicResource WarningChipBrush}" />
                    <Setter TargetName="Icon" Property="Icon" Value="{x:Static services:Icons.Warning}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Bad">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                    <Setter TargetName="IconCircle" Property="Background" Value="{DynamicResource CriticalChipBrush}" />
                    <Setter TargetName="Icon" Property="Icon" Value="{x:Static services:Icons.Warning}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,0,8">
            <!-- Почему SMART прочитан не у всех дисков -->
            <Border Padding="16,12" CornerRadius="10" BorderThickness="1" Margin="0,0,0,14"
                    Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningLineBrush}"
                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowServiceButtons, Converter={StaticResource BoolToVis}}">
                        <Button Content="Установить службу" Command="{Binding InstallServiceCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="От имени администратора" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Диски сами следят за своим здоровьем (SMART): считают ошибки, износ и температуру. Здесь эти счётчики объяснены простыми словами. Проверка только читает данные." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Проверить ещё раз" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource DiskCardTemplate}" Focusable="False" />

            <TextBlock Text="Не найдено ни одного диска. Если это ошибка, соберите отчёт для разработчика в «Настройках»."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- Как читать оценки -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Как понимать оценку" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                               Text="«Хорошо» — признаков износа и неисправностей нет. «Есть тревожные признаки» — появились повреждённые участки или ошибки, сильно израсходован ресурс SSD или диск перегревается: работать можно, но держите копию важных файлов. «Плохо» — диск сам сообщает о неисправности: скопируйте данные как можно скорее." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                               Text="PC Toolkit запоминает счётчики ошибок при каждой проверке и предупредит, если они начнут расти. Но никакая проверка не гарантирует, что диск не откажет внезапно: важные файлы стоит хранить ещё где-то — на втором диске или в облаке." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
