<UserControl x:Class="PcToolkit.Desktop.Views.ChangePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}"
            Padding="26,22"
            Margin="48"
            MaxWidth="1000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Summary}"
                       Style="{StaticResource Caption}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}" />

            <!-- План -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="440"
                          Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Проблемы, из-за которых применить нельзя -->
                    <Border Padding="14,10"
                            Margin="0,0,0,14"
                            CornerRadius="8"
                            Background="{DynamicResource CriticalSoftBrush}"
                            BorderBrush="{DynamicResource CriticalLineBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Применить нельзя:" FontWeight="SemiBold" Foreground="{DynamicResource CriticalBrush}" />
                            <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Таблица «было → станет» -->
                    <StackPanel Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="НАСТРОЙКА" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="ПАРАМЕТР" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="2" Text="БЫЛО" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="3" Text="СТАНЕТ" Style="{StaticResource SectionLabel}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Tweak}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Parameter}"
                                                       Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Before}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding After}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Что не изменится -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="БЕЗ ИЗМЕНЕНИЙ" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Skipped}" Focusable="False" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Результат -->
            <StackPanel Grid.Row="2"
                        Margin="0,14,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultTitle}" FontSize="16" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Точка восстановления -->
            <CheckBox Grid.Row="3"
                      Margin="0,16,0,0"
                      Content="Создать точку восстановления Windows перед изменением (дополнительная страховка)"
                      IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}">
                <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding OfferRestorePoint}" Value="True" />
                                    <Condition Binding="{Binding IsDone}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!-- Кнопки -->
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <TextBlock Text="{Binding BusyText}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding CloseButtonText}"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="100" />
                    <Button Content="{Binding ApplyButtonText}"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="120"
                            Margin="8,0,0,0"
                            Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
