<UserControl x:Class="PcToolkit.Desktop.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid>
            <StackPanel Margin="0,0,200,0">
                <TextBlock Text="Оптимизация" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Настройки Windows с предпросмотром и откатом. Каждое изменение записывается в журнал, и его можно вернуть."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Обновить состояние"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Нет прав администратора -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="10"
                Background="{DynamicResource InfoSoftBrush}"
                BorderBrush="{DynamicResource InfoLineBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="Часть настроек меняет системные параметры и доступна только с правами администратора."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,320,0" />
                <Button Content="Перезапустить от имени администратора"
                        Command="{Binding RestartAsAdminCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Режимы -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,14">
            <RadioButton Content="Подбор по вопросам"
                         GroupName="optimization-mode"
                         Style="{StaticResource TabRadio}"
                         IsChecked="{Binding IsQuestionnaireMode, Mode=TwoWay}" />
            <RadioButton Content="Все настройки"
                         GroupName="optimization-mode"
                         Style="{StaticResource TabRadio}"
                         Margin="6,0,0,0"
                         IsChecked="{Binding IsListMode, Mode=TwoWay}" />
        </StackPanel>

        <!-- Анкета -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="{Binding IsQuestionnaireMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding Questions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource OptionCard}"
                                                         GroupName="{Binding GroupName}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Подобрать настройки"
                            Command="{Binding RecommendCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Подбираются только настройки с низким риском. Остальные доступны во вкладке «Все настройки»."
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Все настройки -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,16">
                <Border Margin="0,0,0,16"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />

                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanSelect}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,2,14,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="18"
                                                                   Margin="0,4,0,0" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Border x:Name="RiskBadge" Style="{StaticResource Badge}">
                                                                <TextBlock x:Name="RiskText" Text="{Binding RiskText}" Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    Visibility="{Binding HasRestart, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding RestartText}" Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="права администратора" Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="StateText"
                                                                   Text="{Binding StateText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   TextAlignment="Right"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="200" />
                                                        <Button Content="Вернуть"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="12,4"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding RevertCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMediumRisk}" Value="True">
                                                    <Setter TargetName="RiskBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                    <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Applied">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AppliedOutside">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Partial">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="NotApplicable">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Unknown">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="4"
                Margin="-32,0,-32,0"
                Padding="32,12"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Снять выбор"
                            Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource GhostButton}" />
                    <Button Content="Предпросмотр изменений"
                            Command="{Binding PreviewCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
