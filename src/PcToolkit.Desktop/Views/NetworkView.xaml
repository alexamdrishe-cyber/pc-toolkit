<UserControl x:Class="PcToolkit.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Результат пинга: точка, куда, что это и что делать; справа значения. -->
        <DataTemplate x:Key="NetworkItemTemplate">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Fill="{DynamicResource GoodBrush}" />
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding What}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Top" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource InfoBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Сеть" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Подходит ли подключение для онлайн-игр: задержка до роутера и до интернета, её скачки (джиттер), потери пакетов и скорость DNS. Только измеряет — ничего не меняет."
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Проверить сеть (15 с)" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="Сравнить DNS" Command="{Binding CompareDnsCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                <Button Content="Стоп" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="220">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" Margin="0,4,0,0"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,0,8">
                <!-- Подключение -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding ConnectionTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConnectionDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border Padding="18,14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,14"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Notice">
                                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                    <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NetworkItemTemplate}" Focusable="False" Margin="0,0,0,14" />

                <!-- DNS -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Скорость DNS" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="DNS превращает имена сайтов и серверов в адреса. Быстрый DNS ускоряет открытие сайтов и подключение к серверам, но не меняет пинг в самой игре. Медиана по 12 популярным адресам." />
                        <ItemsControl ItemsSource="{Binding DnsRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Name" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="Time" Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                            <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DnsAdvice}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Что важно для игр" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                   Text="Задержка (пинг) — сколько идёт сигнал до сервера и обратно. Джиттер — насколько она скачет: даже при низком пинге большой джиттер ощущается как рывки. Потери пакетов — когда часть данных не доходит: в играх это «телепорты» и рассинхронизация. Скорость интернета (Мбит/с) на пинг почти не влияет." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                   Text="Если плохо уже до роутера — дело в домашней сети (Wi-Fi, кабель). Если до роутера хорошо, а до интернета плохо — в провайдере или в загрузках, которые идут в фоне." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
