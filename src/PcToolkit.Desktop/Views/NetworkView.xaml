<UserControl x:Class="PcToolkit.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Результат пинга: точка, куда, что это и что делать; справа значения. -->
        <DataTemplate x:Key="NetworkItemTemplate">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Fill="{DynamicResource GoodBrush}" />
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding What}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Top" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource InfoBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Сеть" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Подходит ли подключение для онлайн-игр: задержка до роутера и до интернета, её скачки (джиттер), потери пакетов и скорость DNS. Только измеряет — ничего не меняет."
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Проверить сеть (15 с)" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="Сравнить DNS" Command="{Binding CompareDnsCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                <Button Content="Стоп" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="220">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" Margin="0,4,0,0"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,0,8">
                <!-- Подключение -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding ConnectionTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConnectionDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border Padding="18,14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,14"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Notice">
                                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                    <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NetworkItemTemplate}" Focusable="False" Margin="0,0,0,14" />

                <!-- DNS -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Скорость DNS" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="DNS превращает имена сайтов и серверов в адреса. Быстрый DNS ускоряет открытие сайтов и подключение к серверам, но не меняет пинг в самой игре. Медиана по 12 популярным адресам." />
                        <ItemsControl ItemsSource="{Binding DnsRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Name" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="Time" Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                            <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DnsAdvice}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Скорость интернета -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Speed}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Скорость интернета" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Ближайший сервер показывает скорость вашего тарифа, далёкий — как быстро качается из другой страны или с другого континента. Открытые серверы LibreSpeed, около 25 секунд." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Стоп" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Проверить скорость" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource SegmentBox}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Ближайший сервер" GroupName="speed-server" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsNear, Mode=TwoWay}" />
                                    <RadioButton Content="Далёкий сервер" GroupName="speed-server" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsFar, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <ComboBox Width="300" Margin="10,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Servers}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding FarServer, Mode=TwoWay}"
                                      Visibility="{Binding IsFar, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" />
                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Style="{StaticResource ThinProgress}" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                        <UniformGrid Columns="2" Margin="0,14,-12,0">
                            <UniformGrid.Resources>
                                <DataTemplate x:Key="SpeedSide">
                                    <Border Margin="0,0,12,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource RowStripeBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding Server}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Скачивание" Style="{StaticResource MutedCaption}" />
                                                    <TextBlock Text="{Binding Download}" FontSize="20" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Отдача" Style="{StaticResource MutedCaption}" />
                                                    <TextBlock Text="{Binding Upload}" FontSize="20" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                                <Run Text="Пинг " /><Run Text="{Binding Ping, Mode=OneWay}" /><Run Text="   ·   джиттер " /><Run Text="{Binding Jitter, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </UniformGrid.Resources>
                            <ContentControl Content="{Binding Near}" ContentTemplate="{StaticResource SpeedSide}" Focusable="False" />
                            <ContentControl Content="{Binding Far}" ContentTemplate="{StaticResource SpeedSide}" Focusable="False" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Трассировка -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0" DataContext="{Binding Trace}">
                    <StackPanel>
                        <StackPanel Margin="18,14,18,12">
                            <TextBlock Text="Маршрут до сервера" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Как WinMTR: по каким узлам идут пакеты и на каком из них начинаются потери — у вас дома, у провайдера или дальше. Потери на одном узле, если дальше их нет, — норма: роутеры экономят на ответах." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Width="220"
                                         Tag="Адрес или IP" ToolTip="Например, адрес игрового сервера" />
                                <Button Content="Google DNS" Command="{Binding PresetCommand}" CommandParameter="8.8.8.8" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                                <Button Content="Cloudflare" Command="{Binding PresetCommand}" CommandParameter="1.1.1.1" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                                <Button Content="Яндекс" Command="{Binding PresetCommand}" CommandParameter="ya.ru" Style="{StaticResource GhostButton}" Margin="6,0,0,0" />
                                <Button Content="Стоп" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Построить маршрут" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedCaption}" Margin="0,8,0,0"
                                       Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                            <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                    Visibility="{Binding VerdictTitle, Converter={StaticResource NullToCollapsed}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Good">
                                                <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding VerdictTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding VerdictDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasHops, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="18,4,18,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="№" Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="1" Text="УЗЕЛ" Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="2" Text="ПОТЕРИ" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="СРЕДНЯЯ" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="ЛУЧШАЯ" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="ХУДШАЯ, МС" Style="{StaticResource SectionLabel}" TextAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Hops}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="18,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="Loss" Grid.Column="2" Text="{Binding Loss}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Average}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{Binding Best}" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Worst}" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasLoss}" Value="True">
                                                <Setter TargetName="Loss" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter TargetName="Loss" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Что важно для игр" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                   Text="Задержка (пинг) — сколько идёт сигнал до сервера и обратно. Джиттер — насколько она скачет: даже при низком пинге большой джиттер ощущается как рывки. Потери пакетов — когда часть данных не доходит: в играх это «телепорты» и рассинхронизация. Скорость интернета (Мбит/с) на пинг почти не влияет." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                   Text="Если плохо уже до роутера — дело в домашней сети (Wi-Fi, кабель). Если до роутера хорошо, а до интернета плохо — в провайдере или в загрузках, которые идут в фоне." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
