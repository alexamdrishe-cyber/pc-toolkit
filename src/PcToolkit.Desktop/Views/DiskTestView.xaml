<UserControl x:Class="PcToolkit.Desktop.Views.DiskTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Вкладка «Скорость» экрана «Диски» (раньше была вкладкой «Диск» на экране «Тесты»). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Как в CrystalDiskMark: временный файл на выбранном диске читается и пишется без кэша Windows. Файл удаляется сразу после замера." />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Настройки -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditOptions}">
                    <StackPanel>
                        <TextBlock Text="ДИСК" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="disk-drive" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,8"
                                                 Style="{StaticResource OptionCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="РАЗМЕР ФАЙЛА" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding Sizes}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ПОВТОРОВ КАЖДОГО ТЕСТА" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
                        <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Каждый тест идёт по 4 секунды, берётся лучший повтор. Замер записывает на диск несколько гигабайт — для SSD это капля в море ресурса." />
                    </StackPanel>
                </Border>

                <!-- Запуск -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Замер скорости" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Четыре теста: последовательное и случайное чтение и запись, около полутора минут при 3 повторах. Закройте программы, которые активно работают с диском." />
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Запустить замер" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Итог -->
            <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                                <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Результаты -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Результаты" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultCaption}" Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ТЕСТ" Style="{StaticResource SectionLabel}" />
                        <TextBlock Grid.Column="1" Text="ЧТЕНИЕ, МБ/С" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="ЗАПИСЬ, МБ/С" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Read}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource InfoBrush}" />
                                            <TextBlock Text="{Binding ReadExtra}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding ReadDelta}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Write}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource GoodBrush}" />
                                            <TextBlock Text="{Binding WriteExtra}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding WriteDelta}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Сравнение -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="С чем сравнить" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Последовательное чтение (SEQ1M Q8T1) вашего диска рядом с типичными скоростями разных накопителей по паспорту. Шкала логарифмическая, иначе жёсткий диск было бы не видно." />
                    <TextBlock Text="{Binding ClassSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ClassRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,8" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarLength}" />
                                                <ColumnDefinition Width="{Binding RestLength}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="{DynamicResource LineBrush}" CornerRadius="5" />
                                            <Border CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEstimate}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
