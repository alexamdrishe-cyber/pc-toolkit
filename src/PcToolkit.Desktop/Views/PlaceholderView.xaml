<UserControl x:Class="PcToolkit.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="32,28,32,20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource Card}" Margin="0,20,0,0" MaxWidth="680" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Stage}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           LineHeight="20" />
                <TextBlock Text="Все изменения системы в этом разделе будут проходить через единый движок с предпросмотром и откатом."
                           Style="{StaticResource Caption}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
