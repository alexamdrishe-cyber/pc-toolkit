<UserControl x:Class="PcToolkit.Desktop.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid>
            <StackPanel Margin="0,0,200,0">
                <TextBlock Text="Очистка" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Временные файлы, кэши и отчёты об ошибках. Перед удалением показывается, что и сколько будет удалено."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Найти заново"
                    Command="{Binding ScanCommand}"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Нет прав администратора -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16,12"
                CornerRadius="10"
                Background="{DynamicResource InfoSoftBrush}"
                BorderBrush="{DynamicResource InfoLineBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="Системные временные файлы и отчёты Windows доступны только с правами администратора."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,320,0" />
                <Button Content="Перезапустить от имени администратора"
                        Command="{Binding RestartAsAdminCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Итог -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,14" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding TotalText}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HistoryText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Правила -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelect}"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,14,0" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Note}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource WarningBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding WarningText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource InfoBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                                    <WrapPanel Margin="0,8,0,0"
                                                               Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}">
                                                        <Border Style="{StaticResource Badge}">
                                                            <TextBlock Text="права администратора" Style="{StaticResource BadgeText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="16,0,0,0" MinWidth="110">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="200"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="4"
                Margin="-32,0,-32,0"
                Padding="32,12"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <Button Content="Предпросмотр очистки"
                        Command="{Binding PreviewCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
