<UserControl x:Class="PcToolkit.Desktop.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PcToolkit.Desktop.Views">

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Диски" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Здоровье дисков с объяснениями, замер скорости и что занимает место."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
            <RadioButton Content="Здоровье" GroupName="disks-tab" Style="{StaticResource TabRadio}" IsChecked="{Binding IsHealthTab, Mode=TwoWay}" />
            <RadioButton Content="Скорость" GroupName="disks-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsSpeedTab, Mode=TwoWay}" />
            <RadioButton Content="Место" GroupName="disks-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsSpaceTab, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding IsHealthTab, Converter={StaticResource BoolToVis}}">
            <views:DiskHealthView DataContext="{Binding Health}" />
        </Grid>
        <Grid Grid.Row="2" Visibility="{Binding IsSpeedTab, Converter={StaticResource BoolToVis}}">
            <views:DiskTestView DataContext="{Binding Speed}" />
        </Grid>
        <Grid Grid.Row="2" Visibility="{Binding IsSpaceTab, Converter={StaticResource BoolToVis}}">
            <views:DiskAnalyzerView DataContext="{Binding Space}" />
        </Grid>
    </Grid>
</UserControl>
