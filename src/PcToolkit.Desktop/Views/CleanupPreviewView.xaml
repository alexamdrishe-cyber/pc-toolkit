<UserControl x:Class="PcToolkit.Desktop.Views.CleanupPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}"
            Padding="26,22"
            Margin="48"
            MaxWidth="820"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Summary}"
                       Style="{StaticResource Caption}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}" />

            <!-- Что будет удалено -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="420"
                          Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ЧТО" Style="{StaticResource SectionLabel}" />
                        <TextBlock Grid.Column="1" Text="ФАЙЛОВ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="РАЗМЕР" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Files}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,14,0,0"
                            Padding="14,10"
                            CornerRadius="8"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource WarningLineBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Результат -->
            <StackPanel Grid.Row="2"
                        Margin="0,14,0,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultTitle}" FontSize="16" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Кнопки -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Text="Удаляю файлы…"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding CloseButtonText}"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="100" />
                    <Button Content="Очистить"
                            Command="{Binding CleanCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="120"
                            Margin="8,0,0,0"
                            Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
