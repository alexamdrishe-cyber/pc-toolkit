<UserControl x:Class="PcToolkit.Desktop.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Строка папки или файла: название, полоска доли, размер, процент, кнопки. -->
        <DataTemplate x:Key="SizeRowTemplate">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="220" Height="8" CornerRadius="4"
                            Background="{StaticResource ControlBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="{Binding BarWidth}" CornerRadius="4"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Открыть"
                                Command="{Binding OpenCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="10,4"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" />
                        <Button Content="В Проводнике"
                                Command="{Binding ShowInExplorerCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="10,4"
                                Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Вкладка «Место» экрана «Диски». -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Пояснение -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Какие папки и файлы занимают больше всего места. Анализ только читает диск и ничего не удаляет."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Grid.Column="1"
                    Content="Обновить список дисков"
                    Command="{Binding RefreshDrivesCommand}"
                    Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Выбор диска -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource OptionCard}"
                                     GroupName="disk-analyzer-drives"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Width="260"
                                     Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Border Width="200" Height="6" CornerRadius="3" Margin="0,8,0,6"
                                        Background="{StaticResource ControlBrush}" HorizontalAlignment="Left">
                                    <Border x:Name="Used" Width="{Binding UsedBarWidth}" CornerRadius="3"
                                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                </Border>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                <Setter TargetName="Used" Property="Background" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Анализировать"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Content="Остановить"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding ProgressText}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="700"
                           Margin="14,0,0,0" />
            </StackPanel>
            <TextBlock Text="Без прав администратора часть системных папок не открывается, и их размер не учитывается."
                       Style="{StaticResource MutedCaption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Итог и вкладки -->
        <StackPanel Grid.Row="2" Margin="0,18,0,8" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton Content="Папки"
                             GroupName="disk-analyzer-mode"
                             Style="{StaticResource TabRadio}"
                             IsChecked="{Binding IsFoldersMode, Mode=TwoWay}" />
                <RadioButton Content="Крупные файлы"
                             GroupName="disk-analyzer-mode"
                             Style="{StaticResource TabRadio}"
                             Margin="6,0,0,0"
                             IsChecked="{Binding IsFilesMode, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Папки -->
        <Grid Grid.Row="3" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid Visibility="{Binding IsFoldersMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Вверх"
                            Command="{Binding UpCommand}"
                            Style="{StaticResource ButtonBase}"
                            Padding="12,4" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SizeRowTemplate}" Focusable="False" />
                </ScrollViewer>
            </Grid>

            <!-- Крупные файлы -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding IsFilesMode, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding LargestFiles}" ItemTemplate="{StaticResource SizeRowTemplate}" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
