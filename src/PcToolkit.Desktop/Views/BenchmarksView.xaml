<UserControl x:Class="PcToolkit.Desktop.Views.BenchmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls">

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Тесты" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Стресс-тесты и замеры производительности. Во время теста другие изменения системы недоступны."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
            <RadioButton Content="Процессор" GroupName="bench-tab" Style="{StaticResource TabRadio}" IsChecked="{Binding IsCpuTab, Mode=TwoWay}" />
            <RadioButton Content="Видеокарта" GroupName="bench-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsGpuTab, Mode=TwoWay}" />
            <RadioButton Content="Память" GroupName="bench-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsMemoryTab, Mode=TwoWay}" />
            <RadioButton Content="Диск" GroupName="bench-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsDiskTab, Mode=TwoWay}" />
        </StackPanel>

        <!-- Заглушки следующих тестов -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsPlaceholderTab, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PlaceholderText}" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13" />
        </Border>

        <!-- Процессор -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding IsCpuTab, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Cpu}" Margin="0,0,0,8">
                <TextBlock Text="{Binding ProcessorText}" Style="{StaticResource Caption}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Настройки теста -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditOptions}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Стресс-тест" GroupName="cpu-mode" Style="{StaticResource TabRadio}" IsChecked="{Binding IsStressMode, Mode=TwoWay}" />
                                <RadioButton Content="Замер производительности" GroupName="cpu-mode" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsBenchmarkMode, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                            <ItemsControl ItemsSource="{Binding Workloads}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Durations}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="ОСТАНОВИТЬ ПРИ ТЕМПЕРАТУРЕ" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
                                <ItemsControl ItemsSource="{Binding TemperatureLimits}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding IsBenchmarkMode, Converter={StaticResource BoolToVis}}"
                                       Text="Каждая нагрузка по 3 секунды в одном потоке и во всех потоках, около 30 секунд. Итоговые баллы считаются по целочисленным вычислениям, плавающей точке и кэшу; скорость памяти показывается отдельно и в баллы не входит. Для точного результата закройте игры и тяжёлые программы." />
                        </StackPanel>
                    </Border>

                    <!-- Показания -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ElapsedText}" FontSize="26" FontWeight="SemiBold" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ОШИБОК" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="Errors" Text="{Binding ErrorsText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="ТЕМПЕРАТУРА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding TemperatureText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MaxTemperatureText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="ЧАСТОТА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ClockText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AverageClockText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                                    <TextBlock Text="МОЩНОСТЬ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding PowerText}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding LoadText}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Температура процессора недоступна: защита от перегрева не сработает. Установите службу в «Настройках»."
                                       Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding ShowTemperatureWarning, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Графики -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ТЕМПЕРАТУРА ЗА ВРЕМЯ ТЕСТА" Style="{StaticResource SectionLabel}" />
                            <controls:Sparkline Height="160" Margin="0,10,0,0" Values="{Binding TemperatureHistory}" Capacity="0"
                                                MinimumRange="10" Unit="°C" Stroke="{StaticResource WarningBrush}"
                                                EmptyText="Появится после запуска стресс-теста" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ЧАСТОТА ЗА ВРЕМЯ ТЕСТА" Style="{StaticResource SectionLabel}" />
                            <controls:Sparkline Height="160" Margin="0,10,0,0" Values="{Binding ClockHistory}" Capacity="0"
                                                MinimumRange="200" Unit="МГц" Stroke="{StaticResource AccentBrush}"
                                                EmptyText="Появится после запуска стресс-теста" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Итог -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                                    <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Результаты замера -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding HasBenchmarkRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Замер производительности" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BenchmarkCaption}" Style="{StaticResource Caption}" Margin="0,2,0,10" />

                        <!-- Итоговые баллы -->
                        <Grid Margin="0,4,0,6" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="1 ПОТОК" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ScoreSingleText}" FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScoreSingleDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ВСЕ ПОТОКИ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ScoreMultiText}" FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScoreMultiDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ScoreReferenceText}" Style="{StaticResource MutedCaption}" Margin="0,0,0,12"
                                   Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ScoreHintText}"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding ShowScoreHint, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="ПОДРОБНО ПО НАГРУЗКАМ" Style="{StaticResource SectionLabel}" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="1 ПОТОК" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="ВСЕ ПОТОКИ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="К ПРОШЛОМУ ЗАМЕРУ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BenchmarkRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Single}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Multi}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Previous}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Сравнение -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Рейтинг процессоров" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                           Text="Популярные модели — примерная оценка: их результаты в Cinebench R23 пересчитаны в баллы этого теста. Точное сравнение — с реальными прогонами: сохраните результат в файл на другом ПК и добавьте сюда." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Сохранить результат в файл" Command="{Binding ExportCommand}" Style="{StaticResource GhostButton}" />
                                <Button Content="Добавить из файла" Command="{Binding ImportCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ComparisonMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasComparisonMessage, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,14,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Все потоки" GroupName="cpu-compare" Style="{StaticResource TabRadio}" IsChecked="{Binding CompareByMulti, Mode=TwoWay}" />
                                <RadioButton Content="1 поток" GroupName="cpu-compare" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding CompareBySingle, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="Популярные процессоры" IsChecked="{Binding ShowPopular, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,8"
                                   Visibility="{Binding HasComparisonSummary, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Пока сравнивать не с чем: сделайте замер со всеми четырьмя нагрузками или включите популярные процессоры." Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCaption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasComparisonRows}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding ComparisonRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,8" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarLength}" />
                                                    <ColumnDefinition Width="{Binding RestLength}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{StaticResource LineBrush}" CornerRadius="5" />
                                                <Border CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEstimate}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SingleText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="1 поток" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MultiText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="все потоки" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="✕" ToolTip="Убрать из сравнения" Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource GhostButton}" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Память -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding IsMemoryTab, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Memory}" Margin="0,0,0,8">
                <TextBlock Text="{Binding ConfigText}" Style="{StaticResource Caption}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Настройки -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditOptions}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Тест стабильности" GroupName="mem-mode" Style="{StaticResource TabRadio}" IsChecked="{Binding IsStressMode, Mode=TwoWay}" />
                                <RadioButton Content="Замер скорости" GroupName="mem-mode" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsBenchmarkMode, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ОБЪЁМ" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Sizes}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />

                                <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Durations}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Цикл — все шесть алгоритмов по всей проверяемой памяти, они повторяются по кругу. 30 минут — обычная проверка; после разгона памяти (XMP/EXPO, тайминги) — 1–2 часа." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding IsBenchmarkMode, Converter={StaticResource BoolToVis}}"
                                       Text="Как в AIDA64: чтение, запись и копирование во всех потоках и задержка случайного доступа, около 15 секунд. Результат сравнивается с теоретическим максимумом ваших модулей. Для точности закройте тяжёлые программы." />
                        </StackPanel>
                    </Border>

                    <!-- Показания -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ElapsedText}" FontSize="26" FontWeight="SemiBold" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ОШИБОК" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ErrorsText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="ЦИКЛ" Style="{StaticResource SectionLabel}" ToolTip="Сколько раз все шесть алгоритмов прошли по всей памяти" />
                                    <TextBlock Text="{Binding CycleText}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="ПРОВЕРЯЕТСЯ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding TestedText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="СЕЙЧАС" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding PatternText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding CycleProgress, Mode=OneWay}" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource MutedCaption}" Margin="0,4,0,0">
                                        <Run Text="Скорость работы теста: " />
                                        <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Алгоритмы -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Что проверяется в каждом цикле" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Классические алгоритмы MemTest86. Каждый поток процессора проверяет свой участок памяти, все одновременно — это нагружает контроллер памяти, как игры." />
                        <ItemsControl ItemsSource="{Binding PatternRows}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4">
                                        <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource LineBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                                    <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Ошибки -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasErrorRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Найденные ошибки" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Первые 100. Если сбоят всегда одни и те же биты — скорее виноват конкретный модуль; если разные — разгон или напряжение." />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ВРЕМЯ" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="АЛГОРИТМ" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="2" Text="АДРЕС" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="3" Text="ЗАПИСАНО" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="4" Text="ПРОЧИТАНО" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="5" Text="БИТЫ" Style="{StaticResource SectionLabel}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ErrorRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Pattern}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Address}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Expected}" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="4" Text="{Binding Actual}" FontFamily="Consolas" Foreground="{StaticResource CriticalBrush}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Bits}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Скорость -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasBenchmark, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Скорость памяти" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BenchmarkCaption}" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ЧТЕНИЕ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ReadText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding ReadDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ЗАПИСЬ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding WriteText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding WriteDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="КОПИРОВАНИЕ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CopyText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding CopyDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ЗАДЕРЖКА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding LatencyText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding LatencyDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TheoreticalText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="Задержка измеряется на обычных страницах Windows, поэтому она на 10–25 нс больше, чем в AIDA64: сравнивайте замеры этой программы между собой."
                                   Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Подсказка про XMP -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                        Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningLineBrush}"
                        Visibility="{Binding HasXmpHint, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding XmpHint}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Диск -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding IsDiskTab, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Disk}" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Как в CrystalDiskMark: временный файл на выбранном диске читается и пишется без кэша Windows. Файл удаляется сразу после замера." />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Настройки -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditOptions}">
                        <StackPanel>
                            <TextBlock Text="ДИСК" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="disk-drive" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,8"
                                                     Style="{StaticResource OptionCard}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="РАЗМЕР ФАЙЛА" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                            <ItemsControl ItemsSource="{Binding Sizes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ПОВТОРОВ КАЖДОГО ТЕСТА" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Каждый тест идёт по 4 секунды, берётся лучший повтор. Замер записывает на диск несколько гигабайт — для SSD это капля в море ресурса." />
                        </StackPanel>
                    </Border>

                    <!-- Запуск -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Замер скорости" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Четыре теста: последовательное и случайное чтение и запись, около полутора минут при 3 повторах. Закройте программы, которые активно работают с диском." />
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Запустить замер" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Итог -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                                    <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Результаты -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Результаты" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultCaption}" Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ТЕСТ" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="ЧТЕНИЕ, МБ/С" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="ЗАПИСЬ, МБ/С" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Read}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource InfoBrush}" />
                                                <TextBlock Text="{Binding ReadExtra}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding ReadDelta}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Write}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource GoodBrush}" />
                                                <TextBlock Text="{Binding WriteExtra}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding WriteDelta}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Сравнение -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="С чем сравнить" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                   Text="Последовательное чтение (SEQ1M Q8T1) вашего диска рядом с типичными скоростями разных накопителей по паспорту. Шкала логарифмическая, иначе жёсткий диск было бы не видно." />
                        <TextBlock Text="{Binding ClassSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ClassRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,8" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarLength}" />
                                                    <ColumnDefinition Width="{Binding RestLength}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{StaticResource LineBrush}" CornerRadius="5" />
                                                <Border CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEstimate}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Видеокарта -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding IsGpuTab, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Gpu}" Margin="0,0,0,8">
                <TextBlock Text="{Binding AdapterText}" Style="{StaticResource Caption}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Настройки теста -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditOptions}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Стресс-тест" GroupName="gpu-mode" Style="{StaticResource TabRadio}" IsChecked="{Binding IsStressMode, Mode=TwoWay}" />
                                <RadioButton Content="Замер производительности" GroupName="gpu-mode" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsBenchmarkMode, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <CheckBox DataContext="{Binding RenderOption}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox DataContext="{Binding ComputeOption}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox DataContext="{Binding MemoryOption}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Durations}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="ОСТАНОВИТЬ ПРИ ТЕМПЕРАТУРЕ ЯДРА" Style="{StaticResource SectionLabel}" Margin="0,10,0,6" />
                                <ItemsControl ItemsSource="{Binding TemperatureLimits}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding IsBenchmarkMode, Converter={StaticResource BoolToVis}}"
                                       Text="Три шага примерно по 8 секунд: 3D-сцена в 4K, скорость вычислений (FP32) и скорость видеопамяти. Итог — одно число в баллах и место в рейтинге видеокарт. Для точного результата закройте игры, браузер с видео и программы записи экрана." />
                        </StackPanel>
                    </Border>

                    <!-- Показания -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ElapsedText}" FontSize="26" FontWeight="SemiBold" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ОШИБОК" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ErrorsText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="ТЕМПЕРАТУРА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding TemperatureText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MaxTemperatureText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="ГОРЯЧАЯ ТОЧКА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding HotSpotText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MaxHotSpotText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,8,10">
                                    <TextBlock Text="ЧАСТОТА ЯДРА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ClockText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AverageClockText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="МОЩНОСТЬ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding PowerText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MaxPowerText}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,0,8,0">
                                    <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding LoadText}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="ВИДЕОПАМЯТЬ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding MemoryText}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Температура видеокарты недоступна: защита от перегрева не сработает."
                                       Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding ShowTemperatureWarning, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Остановить" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Графики -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsStressMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ТЕМПЕРАТУРА ЗА ВРЕМЯ ТЕСТА" Style="{StaticResource SectionLabel}" />
                            <controls:Sparkline Height="160" Margin="0,10,0,0" Values="{Binding TemperatureHistory}" Capacity="0"
                                                MinimumRange="10" Unit="°C" Stroke="{StaticResource WarningBrush}"
                                                EmptyText="Появится после запуска стресс-теста" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ЧАСТОТА ЯДРА ЗА ВРЕМЯ ТЕСТА" Style="{StaticResource SectionLabel}" />
                            <controls:Sparkline Height="160" Margin="0,10,0,0" Values="{Binding ClockHistory}" Capacity="0"
                                                MinimumRange="200" Unit="МГц" Stroke="{StaticResource AccentBrush}"
                                                EmptyText="Появится после запуска стресс-теста" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Итог -->
                <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="critical">
                                    <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Результат замера -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding HasBenchmark, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Замер производительности" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BenchmarkCaption}" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ИТОГ, БАЛЛЫ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ScoreText}" FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScoreDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="3D-СЦЕНА 4K" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding FillText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding FillDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="ВЫЧИСЛЕНИЯ FP32" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding GflopsText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding GflopsDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="СКОРОСТЬ ВИДЕОПАМЯТИ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding BandwidthText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding BandwidthDelta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ScoreReferenceText}" Style="{StaticResource MutedCaption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Рейтинг -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Рейтинг видеокарт" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="Популярные модели — примерная оценка: их результаты в 3DMark Time Spy пересчитаны в баллы этого теста. Ваша строка — реальный замер." />

                        <Grid Margin="0,14,0,8">
                            <TextBlock Text="{Binding RatingSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,200,0" VerticalAlignment="Center" />
                            <CheckBox Content="Популярные видеокарты" IsChecked="{Binding ShowPopular, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Пока сравнивать не с чем: сделайте замер или включите популярные видеокарты." Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedCaption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRatingRows}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding RatingRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,8" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarLength}" />
                                                    <ColumnDefinition Width="{Binding RestLength}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{StaticResource LineBrush}" CornerRadius="5" />
                                                <Border CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEstimate}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="баллов" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
