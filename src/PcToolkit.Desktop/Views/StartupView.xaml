<UserControl x:Class="PcToolkit.Desktop.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Строка списка: название и издатель, оценка влияния, совет, переключатель -->
        <DataTemplate x:Key="StartupRow">
            <Border x:Name="Row" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Command}">
                            <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Place, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ImpactDot" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ImpactText" Text="{Binding ImpactText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="Advice" Grid.Column="2" Text="{Binding AdviceText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip="Запускать вместе с Windows" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Impact}" Value="High">
                    <Setter TargetName="ImpactDot" Property="Fill" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="ImpactText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="Medium">
                    <Setter TargetName="ImpactDot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="Low">
                    <Setter TargetName="ImpactDot" Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="Unknown">
                    <Setter TargetName="ImpactDot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Advice}" Value="CanDisable">
                    <Setter TargetName="Advice" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Автозагрузка" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Что запускается вместе с Windows. Выключенная программа не удаляется и работает как обычно — просто не стартует сама. Вернуть можно здесь же или в «Диспетчере задач»." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                <Button Content="Выключить рекомендованное" Command="{Binding DisableSuggestedCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        ToolTip="Выключить всё, что помечено «Можно выключить»" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,0" />
        <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Оценка «тормозит включение» — по тому, что программа делает при старте: лаунчеры игр и мессенджеры проверяют обновления и грузят диск, помощники драйверов почти ничего не весят." />

        <Border Padding="18,12" CornerRadius="8" BorderThickness="1" Margin="0,14,0,0"
                Background="{DynamicResource CriticalSoftBrush}" BorderBrush="{DynamicResource CriticalLineBrush}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Читаю автозагрузку…" Style="{StaticResource Caption}" Margin="0,16,0,0"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <StackPanel>
                <Grid Margin="18,10,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ПРОГРАММА" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="1" Text="ВЛИЯНИЕ НА ЗАПУСК" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="2" Text="СОВЕТ" Style="{StaticResource SectionLabel}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource RowLineBrush}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource StartupRow}" Focusable="False" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding CanChangeMachine, Converter={StaticResource InverseBoolToVis}}"
                   Text="Программы «для всех пользователей» можно выключить только через службу PC Toolkit («Настройки») или запустив приложение от имени администратора." />
    </StackPanel>
</UserControl>
