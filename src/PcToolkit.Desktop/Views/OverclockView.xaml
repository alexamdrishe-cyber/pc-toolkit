<UserControl x:Class="PcToolkit.Desktop.Views.OverclockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls">

    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChangedValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Один параметр: название, значение с кнопками ±, ползунок, диапазон и заводское значение -->
        <DataTemplate x:Key="TuningSlider">
            <StackPanel Margin="0,10,0,4">
                <Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="−" Command="{Binding DecreaseCommand}" Style="{StaticResource SmallButton}" />
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource ChangedValue}" MinWidth="104" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Command="{Binding IncreaseCommand}" Style="{StaticResource SmallButton}" />
                    </StackPanel>
                </Grid>
                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" SmallChange="{Binding Step}" LargeChange="{Binding ButtonStep}"
                        Margin="0,6,0,2" />
                <Grid>
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="заводское" Command="{Binding DefaultCommand}" Style="{StaticResource SmallButton}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Разгон" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Видеокарта AMD: режимы, частоты, напряжение, видеопамять, питание и вентиляторы — то же, что в AMD Adrenalin, но с предпросмотром, журналом, проверкой стабильности и автоматическим откатом при сбое." />
        </StackPanel>

        <!-- Видеокарта и показания -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource CardTitle}" FontSize="16" />
                        <Border Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAtFactory}" Value="True">
                                            <Setter Property="Background" Value="#1E2430" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FactoryText}" Style="{StaticResource BadgeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding GpuDetails}" Style="{StaticResource MutedCaption}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="ЧАСТОТА" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LiveClock}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="ТЕМПЕРАТУРА" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LiveTemperature}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="ГОРЯЧАЯ ТОЧКА" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LiveHotSpot}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0">
                        <TextBlock Text="МОЩНОСТЬ" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LivePower}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="НАГРУЗКА" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LiveLoad}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Сообщения, ход проверки, недоступность -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Читаю настройки видеокарты…" Style="{StaticResource Caption}" Margin="0,16,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Разгон недоступен" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding UnavailableText}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Content="Проверить снова" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                    Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoLineBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding BusyProgress, Mode=OneWay}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Остановить" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}"
                            Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Настройки -->
        <ScrollViewer Grid.Row="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <StackPanel IsEnabled="{Binding CanEdit}">
                    <!-- Режимы AMD -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Режим" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Готовые режимы AMD. Ручные настройки ниже заменяют режим на «Свой»." Style="{StaticResource MutedCaption}" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Title}" GroupName="gpu-preset" Style="{StaticResource TabRadio}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Включить режим" Command="{Binding ApplyPresetCommand}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Ядро -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasGfx, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Графический процессор" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding GfxSliders}" ItemTemplate="{StaticResource TuningSlider}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding GfxNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Память -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasVram, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Видеопамять" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding VramSliders}" ItemTemplate="{StaticResource TuningSlider}" Focusable="False" />
                            <TextBlock Text="ТАЙМИНГИ" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                            <ItemsControl ItemsSource="{Binding MemoryTimings}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Title}" GroupName="vram-timing" Style="{StaticResource TabRadio}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Быстрые тайминги дают прирост в играх, но не на всех картах стабильны — проверка покажет." Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Питание -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Питание" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding PowerSliders}" ItemTemplate="{StaticResource TuningSlider}" Focusable="False" />
                        </StackPanel>
                    </Border>

                    <!-- Вентиляторы -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasFan, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Вентиляторы" Style="{StaticResource CardTitle}" />
                            <CheckBox IsChecked="{Binding ZeroRpm, Mode=TwoWay}" Margin="0,10,0,0"
                                      Visibility="{Binding HasZeroRpm, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Останавливать вентиляторы без нагрузки (Zero RPM)" />
                                    <TextBlock Text="{Binding ZeroRpmHint}" Style="{StaticResource MutedCaption}" />
                                </StackPanel>
                            </CheckBox>
                            <ItemsControl ItemsSource="{Binding FanSliders}" ItemTemplate="{StaticResource TuningSlider}" Focusable="False" />

                            <StackPanel Visibility="{Binding HasFanCurve, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="КРИВАЯ: ТЕМПЕРАТУРА → СКОРОСТЬ" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                <controls:FanCurveGraph Points="{Binding FanCurvePoints}" Height="160" />
                                <ItemsControl ItemsSource="{Binding FanCurve}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" DataContext="{Binding Temperature}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                                                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ChangedValue}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Grid.Column="3" DataContext="{Binding Speed}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                                                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ChangedValue}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Кривая работает, когда вентиляторы не остановлены режимом Zero RPM. Температуры точек должны расти слева направо."
                                           Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Применить -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding ChangesText}" Style="{StaticResource CardTitle}" />
                            <CheckBox IsChecked="{Binding VerifyAfterApply, Mode=TwoWay}" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}">
                                <StackPanel>
                                    <TextBlock Text="Проверить стабильность после применения" />
                                    <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap"
                                               Text="3D-нагрузка и вычисления со сверкой результата. Ошибки или сброс драйвера — и настройки вернутся сами, даже если компьютер зависнет (откат при следующем запуске)." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="26,8,0,0" IsEnabled="{Binding CanEdit}">
                                <RadioButton Content="1 мин" GroupName="verify" Style="{StaticResource TabRadio}" IsChecked="{Binding Verify1, Mode=TwoWay}" />
                                <RadioButton Content="5 мин" GroupName="verify" Style="{StaticResource TabRadio}" Margin="4,0,0,0" IsChecked="{Binding Verify5, Mode=TwoWay}" />
                                <RadioButton Content="15 мин" GroupName="verify" Style="{StaticResource TabRadio}" Margin="4,0,0,0" IsChecked="{Binding Verify15, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Применить…" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Отменить правки" Command="{Binding DiscardCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                            <Button Content="Выставить заводские значения" Command="{Binding DefaultsCommand}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Перед записью — предпросмотр «было → станет». Все изменения попадают в «Журнал и откат». Если драйвер AMD после сбоя сам сбросит разгон, это нормально: так он защищает видеокарту." />
                        </StackPanel>
                    </Border>

                    <!-- Автоподбор -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Автоподбор по тестам" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,10"
                                       Text="PC Toolkit шаг за шагом меняет одну настройку и после каждого шага нагружает видеокарту на 45 секунд. На первой ошибке берёт последнее стабильное значение с запасом и проверяет его ещё 2 минуты. Занимает 8–12 минут." />
                            <Button Command="{Binding UndervoltCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Андервольт — холоднее и тише" FontWeight="SemiBold" />
                                    <TextBlock Text="Понижает напряжение при тех же частотах. Самое полезное для Radeon 6000/7000." Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OverclockGpuCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Разгон ядра" FontWeight="SemiBold" />
                                    <TextBlock Text="Поднимает максимальную частоту шагами по 25 МГц." Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OverclockVramCommand}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="Разгон видеопамяти" FontWeight="SemiBold" />
                                    <TextBlock Text="Поднимает частоту памяти шагами по 10 МГц." Style="{StaticResource MutedCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Автоподбор доступен, когда нет неприменённых правок. Найденное значение подставится в настройки — применяете его вы."
                                       Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Проверка -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Проверка стабильности" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,10"
                                       Text="Проверить текущие настройки без изменений — длительность как выбрано выше." />
                            <Button Content="Проверить сейчас" Command="{Binding CheckCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
