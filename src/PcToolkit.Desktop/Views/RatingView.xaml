<UserControl x:Class="PcToolkit.Desktop.Views.RatingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- Что это и согласие -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Общий рейтинг" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Не соревнование, а ориентир: что на самом деле выдают такие же устройства у других людей. Для каждой модели — медиана по разным компьютерам, обычный диапазон и что выжимают хорошо охлаждённые экземпляры." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Делиться результатами" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Share, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTip="Анонимно: модель устройства и баллы, без имени и данных компьютера" />
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="16,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ShareStatus}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ShareStatus, Converter={StaticResource NullToCollapsed}}" />

                <!-- Один раз спросить -->
                <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoLineBrush}"
                        Visibility="{Binding ShowSharePrompt, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Добавлять ваши результаты в рейтинг?" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Уходят только модель устройства, баллы и версия теста — без имени компьютера, пользователя и серийных номеров. Чтобы один компьютер не перевешивал остальные, к ним прикладывается обезличенный номер (хеш). Выключить можно в любой момент." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Не сейчас" Command="{Binding DeclineCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="Делиться" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Вид устройства -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton Content="Процессоры" GroupName="rating-kind" Style="{StaticResource TabRadio}" IsChecked="{Binding IsCpu, Mode=TwoWay}" />
            <RadioButton Content="Видеокарты" GroupName="rating-kind" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsGpu, Mode=TwoWay}" />
            <RadioButton Content="Память" GroupName="rating-kind" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsMemory, Mode=TwoWay}" />
            <RadioButton Content="Диски" GroupName="rating-kind" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsDisk, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Text="{Binding KindHint}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="2,10,0,0" />

        <!-- Ваше устройство -->
        <ItemsControl ItemsSource="{Binding Mine}" Focusable="False" Margin="0,12,0,0"
                      Visibility="{Binding HasMine, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="10" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Good">
                                        <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Bad">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="ВАШЕ УСТРОЙСТВО" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VerdictTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VerdictDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding VerdictDetails, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Таблица -->
        <Border Style="{StaticResource Card}" Margin="0,6,0,8">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,260,0" />
                    <CheckBox Content="Модели с малым числом замеров" IsChecked="{Binding ShowUnverified, Mode=TwoWay}"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Style="{StaticResource ThinProgress}" Margin="0,10,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <Grid Margin="8,14,8,6" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="1" Text="МОДЕЛЬ" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="2" Text="МЕДИАНА И ОБЫЧНЫЙ ДИАПАЗОН" Style="{StaticResource SectionLabel}" />
                    <TextBlock Grid.Column="3" Text="{Binding ScoreHeader}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,9" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RankText}" Style="{StaticResource MutedCaption}" FontSize="13" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Grid Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarLength}" />
                                                <ColumnDefinition Width="{Binding RestLength}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="{DynamicResource LineBrush}" CornerRadius="5" />
                                            <Border CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedCaption}" Margin="0,4,0,0"
                                                   Visibility="{Binding RangeText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MedianText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding SecondText}" Style="{StaticResource MutedCaption}" HorizontalAlignment="Right"
                                                   Visibility="{Binding SecondText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
