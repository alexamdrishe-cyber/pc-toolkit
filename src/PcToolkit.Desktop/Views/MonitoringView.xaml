<UserControl x:Class="PcToolkit.Desktop.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls"
             xmlns:services="clr-namespace:PcToolkit.Desktop.Services"
             xmlns:vm="clr-namespace:PcToolkit.Desktop.ViewModels">

    <UserControl.Resources>
        <!-- ===== Таблица «Все датчики» ===== -->
        <DataTemplate DataType="{x:Type vm:TableDeviceHeader}">
            <Border Height="34"
                    Margin="0,6,0,0"
                    Padding="16,0"
                    Background="{DynamicResource TableHeaderBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource DeviceTag}" Background="{Binding Colors.TagBackground}">
                        <TextBlock Text="{Binding Colors.Tag}" Style="{StaticResource DeviceTagText}" Foreground="{Binding Colors.TagForeground}" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TableGroupHeader}">
            <Border Height="34" Padding="16,0,16,5" BorderBrush="{DynamicResource KeyCapLineBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" VerticalAlignment="Bottom" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SensorRowViewModel}">
            <Border x:Name="Row"
                    Height="26"
                    Padding="16,0,8,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource RowLineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextRowBrush}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding OriginalName, Mode=OneWay}" />
                            </TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding MinText}" Style="{StaticResource SmallLabel}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding AvgText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding MaxText}" Style="{StaticResource SmallLabel}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <controls:MiniSpark Grid.Column="5"
                                        Height="18"
                                        Margin="16,0,0,0"
                                        Values="{Binding Spark}"
                                        SampleSeconds="{Binding SparkSampleSeconds}"
                                        FirstIndex="{Binding SparkFirstIndex}"
                                        Stroke="{Binding Colors.AccentBrush}" />
                    <Button x:Name="Pin"
                            Grid.Column="6"
                            Style="{StaticResource IconButton}"
                            Width="26" Height="22"
                            HorizontalAlignment="Right"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Command="{Binding TogglePinCommand}"
                            ToolTip="{Binding PinTooltip}">
                        <controls:IconView Icon="{x:Static services:Icons.Pin}" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsStriped}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowStripeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowPinnedBrush}" />
                    <Setter TargetName="Pin" Property="Foreground" Value="{Binding PinBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Подпись линии графика: цветная черта (или пунктир порога), название, значение -->
        <DataTemplate x:Key="LegendTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                <Border Width="12" Height="3" CornerRadius="1.5" Background="{Binding Brush}" VerticalAlignment="Center"
                        Visibility="{Binding IsLine, Converter={StaticResource BoolToVis}}" />
                <Line Width="12" Height="3" X1="0" X2="12" Y1="1.5" Y2="1.5" Stroke="{Binding Brush}" StrokeThickness="2" StrokeDashArray="2 1.5"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsDashed, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextRowBrush}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="LinkText" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Заголовок и переключатель видов ===== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Мониторинг" Style="{StaticResource PageTitle}" FontSize="22" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SmallLabel}" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding RecordingText}" Style="{StaticResource SmallLabel}" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Обзор" Style="{StaticResource SegmentRadio}" GroupName="MonitoringTab" IsChecked="{Binding IsOverview}" />
                        <RadioButton Content="Все датчики" Style="{StaticResource SegmentRadio}" GroupName="MonitoringTab" IsChecked="{Binding IsTable}" Margin="2,0" />
                        <RadioButton Content="Графики" Style="{StaticResource SegmentRadio}" GroupName="MonitoringTab" IsChecked="{Binding IsGraphs}" />
                    </StackPanel>
                </Border>
                <TextBox Width="190"
                         Margin="10,0,0,0"
                         Style="{StaticResource SearchBox}"
                         Tag="Найти датчик"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="10,0,0,0" Height="34" Style="{StaticResource ButtonBase}" Padding="12,0" Command="{Binding ToggleRecordingCommand}"
                        ToolTip="Записывать все датчики раз в секунду в файл CSV (откроется в Excel)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource CriticalBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RecordButtonText}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding OpenSessionsFolderCommand}" ToolTip="Папка с записями CSV">
                    <controls:IconView Icon="{x:Static services:Icons.Folder}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Вид «Обзор» ===== -->
        <!-- Обзор помещается в окно целиком; таблица и графики занимают всё окно, когда заголовок уехал -->
        <Grid Grid.Row="1" controls:PageScroll.FillHeight="106" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Rows="1" Columns="4" Margin="-6,0">
                <ContentControl Margin="6,0" Focusable="False" Content="{Binding Overview.Tiles.Cpu}" ContentTemplate="{StaticResource DeviceTileTemplate}" />
                <ContentControl Margin="6,0" Focusable="False" Content="{Binding Overview.Tiles.Gpu}" ContentTemplate="{StaticResource DeviceTileTemplate}" />
                <ContentControl Margin="6,0" Focusable="False" Content="{Binding Overview.Tiles.Memory}" ContentTemplate="{StaticResource DeviceTileTemplate}" />
                <ContentControl Margin="6,0" Focusable="False" Content="{Binding Overview.Tiles.Storage}" ContentTemplate="{StaticResource DeviceTileTemplate}" />
            </UniformGrid>

            <ItemsControl Grid.Row="1" Margin="-6,12,-6,0" ItemsSource="{Binding Overview.Columns}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,6,14,10" Margin="6,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}">
                                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <TextBlock Text="Последние 5 минут" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,12,2" />
                                        <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendTemplate}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </WrapPanel>
                                    <controls:LineChart Height="140"
                                                        Margin="0,6,0,0"
                                                        WindowSeconds="300"
                                                        Lines="{Binding Lines}"
                                                        LeftRange="{Binding LeftRange}"
                                                        RightRange="{Binding RightRange}"
                                                        LeftUnit="{Binding LeftUnit}"
                                                        RightUnit="{Binding RightUnit}"
                                                        LeftLabelBrush="{Binding LeftLabelBrush}"
                                                        RightLabelBrush="{Binding RightLabelBrush}" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,4,10">
                                                    <Border Height="32" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource DeviceTag}" Background="{Binding Colors.TagBackground}">
                                                                <TextBlock Text="{Binding Tag}" Style="{StaticResource DeviceTagText}" Foreground="{Binding Colors.TagForeground}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="8,0,8,0"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Sub}" Style="{StaticResource SmallLabel}" FontSize="11.5" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid Height="18" Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="84" />
                                                            <ColumnDefinition Width="76" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="1" Text="сейчас" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        <TextBlock Grid.Column="2" Text="мин–макс" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource GroupTitle}" Margin="0,10,0,3"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding IsLabel, Converter={StaticResource BoolToVis}}" />

                                                                    <Grid Height="22" Visibility="{Binding IsRow, Converter={StaticResource BoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="40" />
                                                                            <ColumnDefinition Width="84" />
                                                                            <ColumnDefinition Width="76" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextRowBrush}"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                                                        <ProgressBar Grid.Column="1" Style="{StaticResource MiniBar}" Value="{Binding BarPercent, Mode=OneWay}"
                                                                                     Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                     Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding RangeText}" Style="{StaticResource SmallLabel}" FontSize="11.5"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <Grid Height="30" Visibility="{Binding IsBars, Converter={StaticResource BoolToVis}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="124" />
                                                                            <ColumnDefinition Width="100" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextRowBrush}"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        <controls:BarStrip Grid.Column="1" Height="20" Values="{Binding Bars}" Fill="{Binding Accent}"
                                                                                           Track="{DynamicResource BarTrackBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding RangeText}" Style="{StaticResource SmallLabel}" FontSize="11.5"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                                                               Visibility="{Binding IsNote, Converter={StaticResource BoolToVis}}">
                                                                        <Hyperlink Style="{StaticResource LinkText}"
                                                                                   Command="{Binding DataContext.SetTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                   CommandParameter="table">
                                                                            <Run Text="{Binding Text, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===== Вид «Все датчики» ===== -->
        <Grid Grid.Row="1" controls:PageScroll.FillHeight="18" Visibility="{Binding IsTable, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="УСТРОЙСТВА" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" Margin="2,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Table.DeviceFilters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3" ToolTip="{Binding Name}"
                                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource SmallLabel}" FontSize="11" Margin="6,0,0,0" />
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ТИП ДАТЧИКА" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" Margin="2,16,0,6" />
                        <ItemsControl ItemsSource="{Binding Table.KindFilters}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,0,5,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ПОКАЗ" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" Margin="2,12,0,6" />
                        <CheckBox IsChecked="{Binding Table.HideEmpty}" Margin="0,3"
                                  ToolTip="Без значения, всегда ноль, пороги производителя, тайминги памяти">
                            <TextBlock Text="Скрывать пустые и служебные" FontSize="12" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Table.OnlyPinned}" Margin="0,3">
                            <TextBlock Text="Только закреплённые" FontSize="12" />
                        </CheckBox>
                        <TextBlock Text="{Binding Table.ShownText}" Style="{StaticResource SmallLabel}" Margin="2,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="214" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource TableHeaderBrush}" CornerRadius="12,12,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="16,0,18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Датчик" Style="{StaticResource SmallLabel}" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Сейчас" Style="{StaticResource SmallLabel}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Мин" Style="{StaticResource SmallLabel}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Среднее" Style="{StaticResource SmallLabel}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Макс" Style="{StaticResource SmallLabel}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="5 минут" Style="{StaticResource SmallLabel}" FontSize="11.5" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Table.Items}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Общий график закреплённых датчиков -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10,16,8">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="На графике" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,2" />
                            <ItemsControl ItemsSource="{Binding Table.PinnedRows}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="26" Margin="0,0,6,2" Padding="10,0,2,0" CornerRadius="13" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="3" CornerRadius="1.5" Background="{Binding PinBrush}" VerticalAlignment="Center" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextRowBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="{Binding DeviceName}">
                                                    <Run Text="{Binding Colors.Tag, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Colors.TagForeground, Mode=OneWay}" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="2,0,0,0"
                                                        Command="{Binding TogglePinCommand}" ToolTip="Убрать с графика">
                                                    <controls:IconView Icon="{x:Static services:Icons.Close}" Width="10" Height="10" StrokeThickness="2.6" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Table.ChartHint}" Style="{StaticResource SmallLabel}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,2" />
                        </WrapPanel>
                        <controls:LineChart WindowSeconds="300"
                                            Lines="{Binding Table.PinLines}"
                                            LeftRange="{Binding Table.PinLeftRange}"
                                            RightRange="{Binding Table.PinRightRange}"
                                            LeftUnit="{Binding Table.PinLeftUnit}"
                                            RightUnit="{Binding Table.PinRightUnit}"
                                            EmptyText="Закрепите датчики булавкой в строке — их графики появятся здесь" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Вид «Графики» ===== -->
        <Grid Grid.Row="1" controls:PageScroll.FillHeight="18" Visibility="{Binding IsGraphs, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentBox}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="1 мин" Style="{StaticResource SegmentRadio}" GroupName="GraphWindow" IsChecked="{Binding Graphs.Is1Min}" />
                        <RadioButton Content="5 мин" Style="{StaticResource SegmentRadio}" GroupName="GraphWindow" IsChecked="{Binding Graphs.Is5Min}" Margin="2,0" />
                        <RadioButton Content="30 мин" Style="{StaticResource SegmentRadio}" GroupName="GraphWindow" IsChecked="{Binding Graphs.Is30Min}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Наведите курсор на график — покажутся значения в этот момент. Красный пунктир — порог, выше которого стоит насторожиться."
                           Style="{StaticResource SmallLabel}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ItemsControl Grid.Row="1" Margin="-6,0" ItemsSource="{Binding Graphs.Cards}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,10,12,6" Margin="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <DockPanel DockPanel.Dock="Top" Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}" Style="{StaticResource SmallLabel}" FontSize="11"
                                               Margin="8,0,0,5" VerticalAlignment="Bottom" ToolTip="Минимум и максимум за выбранный период" />
                                    <TextBlock>
                                        <Run Text="{Binding ValueText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                        <Run Text="{Binding UnitText, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </TextBlock>
                                </DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                                    <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ContentControl Content="{Binding LimitLegend}" ContentTemplate="{StaticResource LegendTemplate}" Focusable="False"
                                                    Visibility="{Binding HasLimit, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                                <controls:LineChart Lines="{Binding Lines}"
                                                    LeftRange="{Binding Range}"
                                                    LeftUnit="{Binding Unit}"
                                                    Limit="{Binding Limit}"
                                                    WindowSeconds="{Binding DataContext.Graphs.WindowSeconds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
