<Window x:Class="PcToolkit.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcToolkit.Desktop.ViewModels"
        xmlns:views="clr-namespace:PcToolkit.Desktop.Views"
        xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls"
        xmlns:services="clr-namespace:PcToolkit.Desktop.Services"
        Title="PC Toolkit"
        Width="1360" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Какой экран показывать для какой модели представления. -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
            <views:SystemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}">
            <views:OptimizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JournalViewModel}">
            <views:JournalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangePreviewViewModel}">
            <views:ChangePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupPreviewViewModel}">
            <views:CleanupPreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
            <views:DiskAnalyzerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UninstallWizardViewModel}">
            <views:UninstallWizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarksViewModel}">
            <views:BenchmarksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GamesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverclockViewModel}">
            <views:OverclockView />
        </DataTemplate>

        <!-- Пункт развёрнутого меню: значок, название, синяя черта у текущего раздела. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Padding="10,0"
                    Margin="0,1">
                <Grid>
                    <Border Width="3"
                            Margin="-10,9,0,9"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Icon="{Binding Icon}" Width="16" Height="16" StrokeThickness="1.7" />
                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Пункт свёрнутого меню: только значок, название во всплывающей подсказке. -->
        <DataTemplate x:Key="NavIconTemplate">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Title}"
                    Width="40"
                    Height="36"
                    HorizontalContentAlignment="Center"
                    Margin="0,1">
                <Grid>
                    <Border Width="3"
                            Margin="-12,9,0,9"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                    <controls:IconView Icon="{Binding Icon}" Width="18" Height="18" StrokeThickness="1.7" Margin="11,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Точка состояния датчиков -->
        <Style x:Key="SourceDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceState}" Value="Running">
                    <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceState}" Value="Failed">
                    <Setter Property="Fill" Value="{StaticResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceState}" Value="Stopped">
                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Развёрнутое меню ===== -->
        <Border Width="232"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="12,16,12,12">
                <Grid DockPanel.Dock="Top" Margin="6,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <controls:IconView Icon="{x:Static services:Icons.Logo}" Width="18" Height="18" StrokeThickness="2.2" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PC Toolkit" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SmallLabel}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Свернуть меню (Ctrl+B)">
                        <controls:IconView Icon="{x:Static services:Icons.Collapse}" Width="17" Height="17" />
                    </Button>
                </Grid>

                <Button DockPanel.Dock="Top"
                        Margin="0,16,0,0"
                        Height="34"
                        Command="{Binding OpenSearchCommand}"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Найти раздел, настройку или датчик">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#34405A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconView Icon="{x:Static services:Icons.Search}" Width="15" Height="15" />
                        <TextBlock Grid.Column="1" Text="Поиск по программе" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" BorderBrush="#2A3240" BorderThickness="1" CornerRadius="4" Padding="5,1" Width="Auto">
                            <TextBlock Text="Ctrl K" Style="{StaticResource SmallLabel}" FontSize="11" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Состояние датчиков и службы -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Padding="12,9,6,9"
                        CornerRadius="9"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardLineBrush}"
                        BorderThickness="1"
                        ToolTip="{Binding StatusTooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource SourceDot}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ServiceStatusText}" FontSize="12" Foreground="{StaticResource TextRowBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SmallLabel}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Width="26" Height="26"
                                VerticalAlignment="Top"
                                Command="{Binding OpenLogsCommand}"
                                ToolTip="Открыть журнал приложения (папка с логами)">
                            <controls:IconView Icon="{x:Static services:Icons.Folder}" Width="15" Height="15" />
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding BottomNav}"
                              ItemTemplate="{StaticResource NavItemTemplate}"
                              Focusable="False" />

                <ScrollViewer Margin="0,14,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding NavGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Caption}"
                                               Style="{StaticResource SmallLabel}"
                                               FontWeight="SemiBold"
                                               Margin="10,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Свёрнутое меню: полоска со значками ===== -->
        <Border Width="64"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,16,0,12">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}" ToolTip="PC Toolkit">
                        <controls:IconView Icon="{x:Static services:Icons.Logo}" Width="18" Height="18" StrokeThickness="2.2" Foreground="White" />
                    </Border>
                    <Button Style="{StaticResource IconButton}"
                            Width="40"
                            Margin="0,10,0,0"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Развернуть меню (Ctrl+B)">
                        <controls:IconView Icon="{x:Static services:Icons.Expand}" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="40" Height="34"
                            Margin="0,8,0,0"
                            BorderThickness="1"
                            Command="{Binding OpenSearchCommand}"
                            ToolTip="Поиск по программе (Ctrl+K)">
                        <controls:IconView Icon="{x:Static services:Icons.Search}" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <Ellipse DockPanel.Dock="Bottom"
                         Style="{StaticResource SourceDot}"
                         Width="8" Height="8"
                         Margin="0,10,0,0"
                         ToolTip="{Binding StatusTooltip}" />

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding BottomNav}"
                              ItemTemplate="{StaticResource NavIconTemplate}"
                              HorizontalAlignment="Center"
                              Focusable="False" />

                <ScrollViewer Margin="0,12,0,8" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ItemsControl ItemsSource="{Binding NavGroups}" HorizontalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <Border Height="1" Width="40" Background="{StaticResource LineBrush}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavIconTemplate}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Текущий экран -->
        <!-- Экраны создаются один раз и потом переиспользуются (см. MainWindow.xaml.cs): переход между разделами мгновенный -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />

        <!-- Предпросмотр изменений поверх всего окна -->
        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="10"
              Visibility="{Binding Preview, Converter={StaticResource NullToCollapsed}}">
            <Border Background="{StaticResource OverlayBrush}" />
            <ContentControl Content="{Binding Preview}" Focusable="False" />
        </Grid>

        <!-- ===== Поиск по программе (Ctrl+K) ===== -->
        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B30A0C10" MouseLeftButtonDown="OnSearchBackdropClick" />
            <Border Width="580"
                    VerticalAlignment="Top"
                    Margin="0,90,0,0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:IconView Icon="{x:Static services:Icons.Search}" Width="17" Height="17" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Margin="10,0,0,0"
                                 Style="{StaticResource SearchBox}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 Tag="Раздел, настройка или датчик — например, «андервольт» или «температура»"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnSearchKeyDown" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding SearchResults}" Margin="6" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RunSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Foreground="{StaticResource TextBrush}"
                                            HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconView Icon="{Binding Icon}" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallLabel}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <TextBlock Text="↑ ↓ — выбрать · Enter — открыть · Esc — закрыть"
                               Style="{StaticResource SmallLabel}"
                               Margin="16,8,16,10" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
