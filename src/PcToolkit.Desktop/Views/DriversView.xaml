<UserControl x:Class="PcToolkit.Desktop.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Проблемное устройство: точка, название, объяснение, что делать, ссылка на сайт. -->
        <DataTemplate x:Key="ProblemTemplate">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Fill="{StaticResource WarningBrush}" />
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Category}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding LinkTitle}" Command="{Binding OpenLinkCommand}" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Top" Visibility="{Binding LinkTitle, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource CriticalBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Драйвер в списке: категория, устройство, версия и дата. -->
        <DataTemplate x:Key="DriverTemplate">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="0,1,12,0" TextWrapping="Wrap" />
                    <Ellipse x:Name="Dot" Grid.Column="1" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Fill="{StaticResource TextMutedBrush}" />
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="{Binding LinkTitle}" Command="{Binding OpenLinkCommand}" Style="{StaticResource GhostButton}"
                            Padding="10,4" VerticalAlignment="Top" Visibility="{Binding LinkTitle, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Notice">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Драйверы" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Устройства без драйвера или с ошибкой и возраст важных драйверов. PC Toolkit ничего не устанавливает сам — только подсказывает, где взять драйвер на официальном сайте."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Диспетчер устройств" Command="{Binding OpenDeviceManagerCommand}" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Проверить ещё раз" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,0,8">
                <Border Padding="18,14" CornerRadius="12" BorderThickness="1" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource GoodSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GoodLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Notice">
                                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                    <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemTemplate}" Focusable="False"
                              Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}" />

                <Border Style="{StaticResource Card}" Margin="0,4,0,0" Visibility="{Binding HasDrivers, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Важные драйверы" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Драйвер видеокарты стоит обновлять раз в несколько месяцев — от него зависят игры. Драйверы сети, звука и дисков обновлять нужно, только если с устройством есть проблемы." />
                        <ItemsControl ItemsSource="{Binding Drivers}" ItemTemplate="{StaticResource DriverTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
