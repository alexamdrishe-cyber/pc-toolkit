<UserControl x:Class="PcToolkit.Desktop.Views.UninstallWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="good">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="critical">
                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="info">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="26,22" Margin="48" MaxWidth="860"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <!-- Заголовок по шагу -->
            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding CurrentText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding LeftoversTitle}" FontSize="19" FontWeight="SemiBold"
                       Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Готово" FontSize="19" FontWeight="SemiBold"
                       Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />

            <!-- Приложения и их состояние -->
            <ScrollViewer MaxHeight="260" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 1. Подтверждение -->
            <StackPanel Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}">
                <CheckBox IsChecked="{Binding SearchLeftovers, Mode=TwoWay}" Margin="0,14,0,0"
                          Visibility="{Binding HasDesktopApps, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="После удаления найти следы" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap"
                                   Text="Оставшиеся папки, ярлыки и записи реестра. Перед удалением вы увидите список и сами решите, что убрать." />
                    </StackPanel>
                </CheckBox>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasDesktopApps, Converter={StaticResource BoolToVis}}"
                           Text="Для программ по очереди откроется их собственный деинсталлятор — пройдите его до конца. Если он предложит перезагрузку, выберите «позже»: перезагрузиться можно после всего." />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasStoreApps, Converter={StaticResource BoolToVis}}"
                           Text="Приложения Microsoft Store удаляются сразу, без окон, и только для вашей учётной записи. Вернуть их можно на экране «Приложения» в списке удалённых." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="Удалить" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Идёт удаление -->
            <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}"
                           Text="Окно деинсталлятора может открыться за этим окном — проверьте панель задач. Если он уже закрылся, а здесь всё ещё ждём, нажмите «Продолжить»." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}">
                    <Button Content="Остановиться после этого" Command="{Binding StopAfterCurrentCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="Деинсталлятор закрылся — продолжить" Command="{Binding ContinueCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 3. Следы -->
            <StackPanel Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LeftoversCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ScrollViewer MaxHeight="400" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Leftovers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <Border Grid.Column="1" Background="{StaticResource ControlBrush}" CornerRadius="6" Padding="6,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12.5" />
                                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap">
                                                <Run Text="{Binding AppName, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Details, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Оставить всё" Command="{Binding SkipLeftoversCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="Удалить выбранное" Command="{Binding RemoveLeftoversCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 4. Итог -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Резервные копии" Command="{Binding OpenBackupCommand}" Style="{StaticResource GhostButton}"
                            Visibility="{Binding HasBackup, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Готово" Command="{Binding DoneCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
