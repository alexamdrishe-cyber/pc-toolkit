<UserControl x:Class="PcToolkit.Desktop.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SecondSeriesBrush" Color="#F5B544" />

        <!-- Список с выделением строки -->
        <Style x:Key="SelectList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionText" TargetType="TextBlock" BasedOn="{StaticResource MutedCaption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="DeltaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Better">
                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Worse">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Игры" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Профили для игр, оверлей с FPS поверх игры и замеры FPS, чтобы сравнить «до и после». Всё, что меняет профиль, после выхода из игры возвращается обратно." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton Content="Игры и профили" GroupName="games-tab" Style="{StaticResource TabRadio}" IsChecked="{Binding IsGamesTab, Mode=TwoWay}" />
            <RadioButton Content="Оверлей" GroupName="games-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsOverlayTab, Mode=TwoWay}" />
            <RadioButton Content="Замеры FPS" GroupName="games-tab" Style="{StaticResource TabRadio}" Margin="6,0,0,0" IsChecked="{Binding IsRecordingsTab, Mode=TwoWay}" />
        </StackPanel>

        <!-- Состояние счётчика кадров -->
        <Border Grid.Row="2" Margin="0,12,0,12" Padding="14,9" CornerRadius="10" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FrameSourceProblem}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FrameStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Установить службу" Command="{Binding InstallServiceCommand}" Style="{StaticResource GhostButton}"
                        Margin="12,0,0,0" Padding="12,4"
                        Visibility="{Binding CanCountFrames, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </Border>

        <!-- ===================== Игры и профили ===================== -->
        <Grid Grid.Row="3" controls:PageScroll.FillHeight="20" Visibility="{Binding IsGamesTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Tag="Поиск игры"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" Text="{Binding GamesSummary}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center"
                                   Margin="12,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Добавить игру…" Command="{Binding AddGameCommand}" Style="{StaticResource GhostButton}"
                                    ToolTip="Выбрать exe-файл игры, которой нет в списке" />
                            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource SelectList}" ItemsSource="{Binding GamesView}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border CornerRadius="8" Background="{DynamicResource ControlBrush}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource GoodSoftBrush}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="запущена" Style="{StaticResource BadgeText}" Foreground="{DynamicResource GoodBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Margin="0"
                                                Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="профиль" Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Профиль выбранной игры -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid>
                        <!-- Ничего не выбрано: что такое профиль -->
                        <StackPanel Visibility="{Binding HasSelectedGame, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Что такое профиль игры" Style="{StaticResource CardTitle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="13"
                                       Text="Это то, что PC Toolkit делает сам, пока игра запущена, и возвращает обратно, когда вы из неё выходите. Ничего не нужно включать перед игрой и выключать после." />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,10,0,0" FontSize="13" LineHeight="20">
                                <Run Text="•  Схема питания «Высокая производительность» — процессор не сбрасывает частоту между кадрами." /><LineBreak />
                                <Run Text="•  Высокий приоритет процесса игры — фоновые программы меньше отнимают процессор." /><LineBreak />
                                <Run Text="•  Оверлей поверх игры: FPS, 1% low, время кадра, загрузка и температуры." /><LineBreak />
                                <Run Text="•  Запись замера FPS за всю игру — потом видно, что изменилось." />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedCaption}" Margin="0,12,0,0"
                                       Text="Выберите игру слева и включите профиль. Если игры нет в списке — «Добавить игру…» или вкладка «Оверлей» → «Сейчас выводят кадры»." />
                        </StackPanel>

                        <!-- Выбрана игра -->
                        <StackPanel DataContext="{Binding SelectedGame}"
                                    Visibility="{Binding DataContext.HasSelectedGame, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Source}" Style="{StaticResource MutedCaption}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding InstallDir}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <CheckBox IsChecked="{Binding ProfileEnabled, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="Профиль включён" FontWeight="SemiBold" />
                                        <TextBlock Text="Применяется сам при запуске игры и отменяется после выхода" Style="{StaticResource OptionText}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <StackPanel IsEnabled="{Binding ProfileEnabled}" Margin="0,6,0,0">
                                <TextBlock Text="НА ВРЕМЯ ИГРЫ" Style="{StaticResource SectionLabel}" Margin="0,10,0,4" />
                                <CheckBox IsChecked="{Binding PowerPlan, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Схема питания «Высокая производительность»" />
                                        <TextBlock Style="{StaticResource OptionText}"
                                                   Text="Процессор держит высокую частоту, меньше задержек между кадрами. После игры вернётся ваша схема — если вы не поменяли её сами." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding HighPriority, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Высокий приоритет процесса игры" />
                                        <TextBlock Style="{StaticResource OptionText}"
                                                   Text="Windows отдаёт игре больше процессорного времени, чем фоновым программам. Игры с защитой от читов иногда не разрешают это — тогда просто ничего не изменится." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Overlay, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Оверлей с FPS и датчиками" />
                                        <TextBlock Style="{StaticResource OptionText}" Text="Поверх игры. Ctrl+Shift+F10 — скрыть или показать." />
                                    </StackPanel>
                                </CheckBox>
                                <Button Content="Настроить оверлей для этой игры…" Command="{Binding ConfigureOverlayCommand}"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="10,3" Margin="26,0,0,6" />
                                <CheckBox IsChecked="{Binding RecordFps, Mode=TwoWay}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Записывать замер FPS" />
                                        <TextBlock Style="{StaticResource OptionText}"
                                                   Text="Вся игровая сессия попадёт во вкладку «Замеры FPS»: средний FPS, 1% low, рывки — для сравнения «до и после»." />
                                    </StackPanel>
                                </CheckBox>

                                <!-- Видеокарта AMD: только если драйвер даёт эти настройки -->
                                <StackPanel Visibility="{Binding DataContext.RadeonAvailable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ВИДЕОКАРТА AMD" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                    <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Не менять" GroupName="radeon-mode" Style="{StaticResource SegmentRadio}"
                                                         IsChecked="{Binding RadeonNone, Mode=TwoWay}" />
                                            <RadioButton Content="Anti-Lag" GroupName="radeon-mode" Style="{StaticResource SegmentRadio}"
                                                         IsChecked="{Binding RadeonAntiLag, Mode=TwoWay}"
                                                         IsEnabled="{Binding DataContext.RadeonAntiLagSupported, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <RadioButton Content="Chill" GroupName="radeon-mode" Style="{StaticResource SegmentRadio}"
                                                         IsChecked="{Binding RadeonChill, Mode=TwoWay}"
                                                         IsEnabled="{Binding DataContext.RadeonChillSupported, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <RadioButton Content="Лимит FPS" GroupName="radeon-mode" Style="{StaticResource SegmentRadio}"
                                                         IsChecked="{Binding RadeonLimit, Mode=TwoWay}"
                                                         IsEnabled="{Binding DataContext.RadeonChillSupported, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding RadeonModeText}" Style="{StaticResource OptionText}" Margin="0,6,0,0" />

                                    <Grid Margin="0,8,0,0" Visibility="{Binding RadeonChill, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="В покое, FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="{Binding DataContext.ChillFpsMin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Maximum="{Binding DataContext.ChillFpsMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding ChillMinFps, Mode=TwoWay, Delay=300}" />
                                        <TextBlock Grid.Row="1" Text="В движении, FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0" />
                                        <Slider Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                                Minimum="{Binding DataContext.ChillFpsMin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Maximum="{Binding DataContext.ChillFpsMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding ChillMaxFps, Mode=TwoWay, Delay=300}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChillText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0" Visibility="{Binding RadeonLimit, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Предел, FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="{Binding DataContext.ChillFpsMin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Maximum="{Binding DataContext.ChillFpsMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                                Value="{Binding LimitFps, Mode=TwoWay, Delay=300}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LimitText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding Sharpening, Mode=TwoWay}" Margin="0,10,0,4"
                                              IsEnabled="{Binding DataContext.RadeonSharpeningSupported, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel>
                                            <TextBlock Text="Резкость (Radeon Image Sharpening)" />
                                            <TextBlock Style="{StaticResource OptionText}"
                                                       Text="Делает картинку чётче, особенно со сглаживанием TAA или на пониженном разрешении. На FPS почти не влияет." />
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid Margin="28,2,0,0" Visibility="{Binding Sharpening, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                Value="{Binding Sharpness, Mode=TwoWay, Delay=300}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SharpnessText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource OptionText}" Margin="0,6,0,0"
                                               Text="Эти настройки драйвера действуют на все игры, поэтому включаются только пока идёт эта игра. После выхода вернётся как было — если вы не поменяли их сами в AMD Software." />
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoLineBrush}"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" LineHeight="19" />
                            </Border>

                            <Button Content="Убрать игру из списка" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===================== Оверлей ===================== -->
        <Grid Grid.Row="3" controls:PageScroll.FillHeight="20" Visibility="{Binding IsOverlayTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="440" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="9*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: что показывать и как -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding OverlayEnabled, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Показывать оверлей во всех играх" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource OptionText}" Text="В играх из списка и в любой программе на весь экран; в браузере и обычных окнах оверлея нет. Можно включать и только для отдельных игр — галочкой в их профиле." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <StackPanel DataContext="{Binding OverlayEditor}">
                        <!-- Для чего настраиваем -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ОВЕРЛЕЙ ДЛЯ" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          HorizontalAlignment="Left" MinWidth="300" MaxWidth="460"
                                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Visibility="{Binding IsGameTarget, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Как во всех играх" GroupName="overlay-own" Style="{StaticResource SegmentRadio}" IsChecked="{Binding UseCommonLayout, Mode=TwoWay}" />
                                        <RadioButton Content="Свой для этой игры" GroupName="overlay-own" Style="{StaticResource SegmentRadio}" IsChecked="{Binding UseOwnLayout, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding TargetHint}" Style="{StaticResource OptionText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Показатели -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ПОКАЗАТЕЛИ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Столбиком" GroupName="overlay-orientation" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsVertical, Mode=TwoWay}" />
                                            <RadioButton Content="В строку" GroupName="overlay-orientation" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsHorizontal, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource OptionText}" Margin="0,6,0,8"
                                           Text="Порядок — стрелками, галочка — показывать. «График» рисует значение за последние секунды, «Крупно» — как FPS. Подпись, пороги цвета и «в одной строке» — по кнопке с шестерёнкой." />

                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconButton}" Width="24" Height="17" Command="{Binding MoveUpCommand}" ToolTip="Выше">
                                                                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="10" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Width="24" Height="17" Command="{Binding MoveDownCommand}" ToolTip="Ниже">
                                                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" />
                                                            </Button>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,6,0"
                                                                  ToolTip="Показывать в оверлее" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedCaption}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ToggleButton Content="График" Style="{StaticResource ChipToggle}" IsChecked="{Binding Graph, Mode=TwoWay}" Margin="0,0,6,0"
                                                                          Visibility="{Binding CanGraph, Converter={StaticResource BoolToVis}}" />
                                                            <ToggleButton Content="Крупно" Style="{StaticResource ChipToggle}" IsChecked="{Binding Big, Mode=TwoWay}" />
                                                        </StackPanel>
                                                        <controls:ColorPickerButton Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" AllowDefault="True"
                                                                                    Color="{Binding Color, Mode=TwoWay}" DefaultColor="{Binding DefaultColor}" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleExpandCommand}" ToolTip="Подпись, пороги цвета, строка">
                                                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}" ToolTip="Убрать из оверлея">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Подробно: подпись, строка, пороги -->
                                                    <Border Margin="62,8,4,4" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlBrush}"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Text="Подпись" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBox Style="{StaticResource SearchBox}" Height="28" Width="160" FontSize="12.5"
                                                                         Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="без подписи" />
                                                                <TextBlock Text="{Binding DefaultLabel}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                            </StackPanel>

                                                            <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" IsChecked="{Binding SameLine, Mode=TwoWay}"
                                                                      Content="{Binding SameLineText}" Visibility="{Binding CanSameLine, Converter={StaticResource BoolToVis}}" />

                                                            <TextBlock Grid.Row="2" Text="Пороги цвета" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,10,0,0"
                                                                       Visibility="{Binding HasThresholds, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"
                                                                        Visibility="{Binding HasThresholds, Converter={StaticResource BoolToVis}}">
                                                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                                                <TextBox Style="{StaticResource SearchBox}" Height="28" Width="70" FontSize="12.5" Margin="6,0,0,0"
                                                                         Text="{Binding WarnText, Mode=TwoWay}" Tag="нет" KeyDown="OnApplyOnEnter" ToolTip="Порог «внимание» (жёлтый). Пусто — нет порога. Enter — применить." />
                                                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource CriticalBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                                                <TextBox Style="{StaticResource SearchBox}" Height="28" Width="70" FontSize="12.5" Margin="6,0,0,0"
                                                                         Text="{Binding CriticalText, Mode=TwoWay}" Tag="нет" KeyDown="OnApplyOnEnter" ToolTip="Порог «опасно» (красный). Пусто — нет порога. Enter — применить." />
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ThresholdHint}" Style="{StaticResource OptionText}" Margin="0,6,0,0"
                                                                       Visibility="{Binding HasThresholds, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="В оверлее пока нет показателей — добавьте хотя бы один." Style="{StaticResource Caption}" Margin="0,6"
                                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}" />

                                <Grid Margin="0,10,0,0">
                                    <Button x:Name="AddMetricButton" Content="+ Добавить показатель" Style="{StaticResource GhostButton}" Padding="12,4"
                                            HorizontalAlignment="Left" Command="{Binding OpenAddCommand}" />
                                    <Popup IsOpen="{Binding IsAddOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AddMetricButton}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="OnAddMetricOpened">
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" Width="460" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBox x:Name="AddMetricSearch" Style="{StaticResource SearchBox}" Tag="Поиск: температура, частота, вентилятор…"
                                                         Text="{Binding AddSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                                <ListBox ItemsSource="{Binding AddChoices}" MaxHeight="400" Margin="0,6,0,0" Background="Transparent" BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <ContentPresenter />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="8,10,8,4"
                                                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" />
                                                                <Button Command="{Binding DataContext.AddMetricCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                                        Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHoverBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="Ничего не нашлось." Style="{StaticResource Caption}" Margin="8,10"
                                                           Visibility="{Binding HasNoChoices, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Оформление -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="ОФОРМЛЕНИЕ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Text="Шрифт" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                                          HorizontalAlignment="Left" Width="260"
                                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Размер" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Slider Minimum="8" Maximum="40" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="220"
                                            Value="{Binding FontSize, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:0.#}}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="Толщина букв" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SegmentBox}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Обычные" GroupName="overlay-weight" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsNormalWeight, Mode=TwoWay}" />
                                        <RadioButton Content="Полужирные" GroupName="overlay-weight" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsSemiBoldWeight, Mode=TwoWay}" />
                                        <RadioButton Content="Жирные" GroupName="overlay-weight" Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsBoldWeight, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="4" Text="Цвета" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:ColorPickerButton Color="{Binding ValueColor, Mode=TwoWay}" DefaultColor="#E8EBF1" />
                                        <TextBlock Text="значения" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:ColorPickerButton Color="{Binding LabelColor, Mode=TwoWay}" DefaultColor="#9AA3B5" />
                                        <TextBlock Text="подписи" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:ColorPickerButton Color="{Binding GraphColor, Mode=TwoWay}" DefaultColor="#34D399" />
                                        <TextBlock Text="графики" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Grid.Row="5" Text="Пороги" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:ColorPickerButton Color="{Binding WarnColor, Mode=TwoWay}" DefaultColor="#F5B544" />
                                        <TextBlock Text="внимание" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:ColorPickerButton Color="{Binding CriticalColor, Mode=TwoWay}" DefaultColor="#F2645F" />
                                        <TextBlock Text="опасно" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Grid.Row="6" Text="Обводка букв" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Slider Minimum="0" Maximum="4" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="160"
                                            Value="{Binding Outline, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutlineText}" Style="{StaticResource Caption}" Width="52" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <controls:ColorPickerButton Color="{Binding OutlineColor, Mode=TwoWay}" DefaultColor="#000000" />
                                </StackPanel>

                                <TextBlock Grid.Row="7" Text="Фон" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Width="160"
                                            Value="{Binding BackgroundPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BackgroundPercent, StringFormat={}{0:0} %}" Style="{StaticResource Caption}" Width="52" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <controls:ColorPickerButton Color="{Binding BackgroundColor, Mode=TwoWay}" DefaultColor="#0E1116" />
                                </StackPanel>

                                <TextBlock Grid.Row="8" Text="Скругление" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,12,0,0" />
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Slider Minimum="0" Maximum="24" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True" Width="160"
                                            Value="{Binding CornerRadius, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CornerRadius, StringFormat={}{0:0} пкс}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Место на экране -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
                            <StackPanel>
                                <TextBlock Text="МЕСТО НА ЭКРАНЕ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <UniformGrid Columns="3" HorizontalAlignment="Left">
                                    <RadioButton Content="Слева вверху" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsTopLeft, Mode=TwoWay}" Margin="0,0,4,4" />
                                    <RadioButton Content="Вверху по центру" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsTopCenter, Mode=TwoWay}" Margin="0,0,4,4" />
                                    <RadioButton Content="Справа вверху" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsTopRight, Mode=TwoWay}" Margin="0,0,4,4" />
                                    <RadioButton Content="Слева внизу" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsBottomLeft, Mode=TwoWay}" Margin="0,0,4,4" />
                                    <RadioButton Content="Внизу по центру" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsBottomCenter, Mode=TwoWay}" Margin="0,0,4,4" />
                                    <RadioButton Content="Справа внизу" GroupName="overlay-anchor" Style="{StaticResource TabRadio}" IsChecked="{Binding IsBottomRight, Mode=TwoWay}" Margin="0,0,4,4" />
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Передвинуть мышью" Command="{Binding ToggleMovingCommand}" Style="{StaticResource GhostButton}" Padding="14,5"
                                            Visibility="{Binding IsMoving, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button Content="Готово" Command="{Binding ToggleMovingCommand}" Style="{StaticResource PrimaryButton}" Padding="18,5"
                                            Visibility="{Binding IsMoving, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource OptionText}" Margin="0,8,0,0"
                                           Text="Оверлей появится на экране в рамке — перетащите его мышью куда угодно, хоть на другой монитор. Закончить — «Готово» или двойной щелчок по оверлею. Место считается от ближайшего угла или середины края, поэтому сохраняется при любом разрешении." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Правая колонка: предпросмотр и остальное -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" DataContext="{Binding OverlayEditor}">
                        <StackPanel>
                            <TextBlock Text="Предпросмотр" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Text="Датчики — настоящие, FPS — из игры, а пока игры нет — пример. Всё, что меняете, сразу видно и здесь, и в игре: применять не нужно." />
                            <Border CornerRadius="8" MinHeight="250" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6E9CC9" Offset="0" />
                                        <GradientStop Color="#C9D8E4" Offset="0.55" />
                                        <GradientStop Color="#7C8F5A" Offset="0.56" />
                                        <GradientStop Color="#3E5230" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Path Data="M0,60 L60,25 L110,50 L170,10 L240,45 L300,20 L360,55 L420,30 L480,50 L480,80 L0,80 Z" Fill="#55607A"
                                          Stretch="Fill" VerticalAlignment="Center" Height="70" Margin="0,0,0,20" Opacity="0.55" IsHitTestVisible="False" />
                                    <!-- Широкий оверлей «в строку» уменьшается, чтобы поместиться целиком; обычный — в настоящем размере. -->
                                    <Viewbox StretchDirection="DownOnly" Margin="12"
                                             HorizontalAlignment="{Binding PreviewHorizontal}" VerticalAlignment="{Binding PreviewVertical}">
                                        <controls:OverlayView Source="{Binding Preview}" />
                                    </Viewbox>
                                    <TextBlock Text="Оверлей пуст" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="20">
                                <Run Text="Ctrl+Shift+F10" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" — показать или скрыть оверлей" /><LineBreak />
                                <Run Text="Ctrl+Shift+F11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" — начать или остановить запись FPS" />
                            </TextBlock>
                            <TextBlock Text="{Binding HotkeyWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Оверлей — прозрачное окно поверх игры: в игру ничего не внедряется, поэтому античиты на него не реагируют. Виден в оконном режиме и «полноэкранном в окне» (borderless), а также в полноэкранном режиме большинства современных игр. Если в какой-то игре его не видно, переключите её в режим «без рамки»." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Сейчас выводят кадры" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,2,0,8"
                                       Text="Программы, которые рисуют через Direct3D, — игры, браузеры, видеоплееры. Если игры нет в списке игр, её можно добавить отсюда." />
                            <TextBlock Text="Сейчас никто не выводит кадры. Запустите игру — она появится здесь."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6"
                                       Visibility="{Binding HasPresenters, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Presenters}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Api}" Style="{StaticResource MutedCaption}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FpsText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                                <Button Grid.Column="2" Content="Добавить в игры" Command="{Binding AddCommand}" Style="{StaticResource GhostButton}"
                                                        Padding="10,3" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="2" Text="в списке игр" Style="{StaticResource MutedCaption}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsKnownGame, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="РАБОТА В ФОНЕ" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="Крестик сворачивает PC Toolkit в трей" />
                                    <TextBlock Style="{StaticResource OptionText}"
                                               Text="Профили игр и оверлей продолжают работать. Выйти совсем — правой кнопкой по значку в трее → «Выход»." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="Запускать вместе с Windows" />
                                    <TextBlock Style="{StaticResource OptionText}" Text="Сразу в трей, без окна — чтобы профили срабатывали без открытия программы." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Замеры FPS ===================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsRecordingsTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton Content="30 с" GroupName="rec-duration" Style="{StaticResource TabRadio}" IsChecked="{Binding IsDuration30, Mode=TwoWay}" />
                            <RadioButton Content="1 мин" GroupName="rec-duration" Style="{StaticResource TabRadio}" Margin="4,0,0,0" IsChecked="{Binding IsDuration60, Mode=TwoWay}" />
                            <RadioButton Content="2 мин" GroupName="rec-duration" Style="{StaticResource TabRadio}" Margin="4,0,0,0" IsChecked="{Binding IsDuration120, Mode=TwoWay}" />
                            <RadioButton Content="До остановки" GroupName="rec-duration" Style="{StaticResource TabRadio}" Margin="4,0,0,0" IsChecked="{Binding IsDurationUnlimited, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecordingStatus}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Удобнее всего — Ctrl+Shift+F11 прямо в игре: запишется игра на экране. Для честного сравнения записывайте одну и ту же сцену (тот же уровень, тот же маршрут) одинаковое время." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding RecordingButtonText}" Command="{Binding ToggleRecordingCommand}"
                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Список замеров -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="СОХРАНЁННЫЕ ЗАМЕРЫ — отметьте «до» и «после»" Style="{StaticResource SectionLabel}" Margin="16,12,16,8" />
                        <TextBlock Grid.Row="1" Text="Замеров пока нет." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasRecordings, Converter={StaticResource InverseBoolToVis}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Recordings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <ToggleButton Content="До" IsChecked="{Binding IsBefore, Mode=TwoWay}" Style="{StaticResource ChipToggle}"
                                                                  ToolTip="Замер «до» изменения (например, без профиля)" />
                                                    <ToggleButton Content="После" IsChecked="{Binding IsAfter, Mode=TwoWay}" Style="{StaticResource ChipToggle}" Margin="4,0,0,0"
                                                                  ToolTip="Замер «после» изменения (например, с профилем)" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource AccentSoftBrush}"
                                                                Visibility="{Binding ProfileActive, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="профиль" Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedCaption}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding DeleteCommand}" Style="{StaticResource GhostButton}" Padding="8,4"
                                                        VerticalAlignment="Center" ToolTip="Удалить замер">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Подробности и сравнение -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"
                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}"
                                   Text="Отметьте замер кнопкой «До», чтобы посмотреть подробности, или замеры «До» и «После», чтобы сравнить их: например без профиля и с профилем или до и после обновления драйвера. Для надёжного вывода запишите по 3 прогона одной сцены с каждой стороны и отметьте их все — программа учтёт разброс между прогонами и скажет, выходит ли разница за погрешность." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding HasNoSelection, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel DataContext="{Binding Comparison}">
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="12" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding TitleA}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding DataContext.HasComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Width="12" Height="3" Fill="{DynamicResource SecondSeriesBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding TitleB}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="Снять отметки" Style="{StaticResource GhostButton}" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding DataContext.ClearComparisonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>

                                <TextBlock Text="{Binding TimelineCaption}" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                                <controls:Sparkline Values="{Binding TimelineA}" Height="140" Unit="FPS" Capacity="0" SampleSeconds="1"
                                                    Stroke="{DynamicResource AccentBrush}" GridBrush="{DynamicResource LineBrush}" EmptyText="нет данных" />
                                <controls:Sparkline Values="{Binding TimelineB}" Height="140" Unit="FPS" Capacity="0" SampleSeconds="1" Margin="0,8,0,0"
                                                    Stroke="{DynamicResource SecondSeriesBrush}" GridBrush="{DynamicResource LineBrush}" EmptyText="нет данных"
                                                    Visibility="{Binding DataContext.HasComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

                                <Grid Margin="0,16,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ПОКАЗАТЕЛЬ" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding HeaderA}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="ПОСЛЕ" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"
                                               Visibility="{Binding DataContext.HasComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Column="3" Text="РАЗНИЦА" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right"
                                               Visibility="{Binding DataContext.HasComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Metric}" Style="{StaticResource Caption}" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Text="{Binding A}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding B}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                               Visibility="{Binding DataContext.HasComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource DeltaText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding SpreadText}" Style="{StaticResource MutedCaption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasSpread, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
