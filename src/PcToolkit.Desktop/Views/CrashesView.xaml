<UserControl x:Class="PcToolkit.Desktop.Views.CrashesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PcToolkit.Desktop.Controls"
             xmlns:services="clr-namespace:PcToolkit.Desktop.Services">

    <UserControl.Resources>
        <!-- Карточка однотипных сбоев. -->
        <DataTemplate x:Key="CrashGroupTemplate">
            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                 Fill="{DynamicResource InfoBrush}" />
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastText}" Style="{StaticResource MutedCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                Style="{StaticResource GhostButton}" Padding="10,4" VerticalAlignment="Top" />
                    </Grid>

                    <StackPanel Margin="18,8,0,0">
                        <TextBlock Text="{Binding What}" TextWrapping="Wrap" LineHeight="20" />
                        <TextBlock Text="{Binding CausesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"
                                   Visibility="{Binding CausesText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" LineHeight="19" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Visibility="{Binding AdviceText, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreText}" Style="{StaticResource MutedCaption}" Margin="0,6,0,0"
                                       Visibility="{Binding MoreText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource CriticalBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Сбои" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Синие экраны, внезапные выключения, вылеты игр и ошибки железа из журнала Windows — с объяснением, что это значит. Только чтение."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Папка с дампами" Command="{Binding OpenDumpsCommand}" Style="{StaticResource GhostButton}" />
                <Button Content="Просмотр событий" Command="{Binding OpenEventViewerCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding Periods}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Title}" GroupName="{Binding GroupName}" Style="{StaticResource TabRadio}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" Margin="12,0" />
            <Button Grid.Column="2" Content="Проверить ещё раз" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,0,8">
                <!-- Восстановление Windows -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" DataContext="{Binding Repair}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Восстановление Windows" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Проверяет системные файлы и восстанавливает повреждённые — помогает при синих экранах, вылетах и странных ошибках Windows. Это встроенные средства Windows (DISM и sfc): нужен интернет, 10–30 минут, Windows спросит разрешение." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Проверить и восстановить" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" />
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Style="{StaticResource ThinProgress}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="good">
                                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="warning">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ResultKind}" Value="bad">
                                            <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LastRunText}" Style="{StaticResource MutedCaption}" VerticalAlignment="Center" />
                                    <Button Content="Журнал CBS" Command="{Binding OpenLogCommand}" Style="{StaticResource GhostButton}" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border x:Name="SummaryCard" Padding="18,14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Notice">
                                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InfoLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                    <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Hints}" Margin="0,6,0,0" Focusable="False"
                                      Visibility="{Binding HasHints, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReadError}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding ReadError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource CrashGroupTemplate}" Focusable="False" />

                <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Откуда эти данные" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"
                                   Text="Windows записывает в свой журнал каждый синий экран, неожиданное выключение, аппаратную ошибку и вылет программы. PC Toolkit выбирает из журнала только сбои и объясняет их. Причина указана как самая частая для такого сбоя: точно её покажет только разбор дампа памяти (файлы в папке Minidump)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
