<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Светлая тема: белые карточки на светло-сером фоне. Ключи одинаковые в обеих темах; стили ссылаются на них через DynamicResource. -->
    <Color x:Key="AccentColor">#2B6BDF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6BDF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#262B6BDF" />
    <LinearGradientBrush x:Key="AccentAreaBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#352B6BDF" Offset="0" />
        <GradientStop Color="#002B6BDF" Offset="1" />
    </LinearGradientBrush>

    <!-- Фон окна (страницы) -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
    <!-- Боковое меню -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#E8E9EC" />
    <!-- Карточка -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F5F6F8" />
    <!-- Рамка карточки: в тёмной почти не видна -->
    <SolidColorBrush x:Key="CardLineBrush" Color="#E1E3E7" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <!-- Разделители -->
    <SolidColorBrush x:Key="LineBrush" Color="#DCDFE4" />
    <SolidColorBrush x:Key="ControlBrush" Color="#ECEDF0" />
    <!-- Рамка флажков и переключателей -->
    <SolidColorBrush x:Key="ControlLineBrush" Color="#A6ABB4" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A505A" />
    <!-- Подписи мелким шрифтом: контраст с карточкой не ниже 4.5:1 -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#666C76" />
    <SolidColorBrush x:Key="TextRowBrush" Color="#2A2E35" />
    <!-- Меню, вкладки, таблицы, графики -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#DDDFE3" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#D5D9E0" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowStripeBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="RowPinnedBrush" Color="#E6EDFB" />
    <SolidColorBrush x:Key="RowLineBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#F1F2F4" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E1E3E7" />
    <SolidColorBrush x:Key="ChartMinorGridBrush" Color="#EEF0F2" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#E1E3E7" />
    <SolidColorBrush x:Key="ListHoverBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#ECEDF0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C7CE" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A8ADB6" />
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#8D939D" />
    <SolidColorBrush x:Key="SearchHoverLineBrush" Color="#A6ABB4" />
    <SolidColorBrush x:Key="KeyCapLineBrush" Color="#D0D3D9" />
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#E2EAFB" />
    <SolidColorBrush x:Key="ChipSelectedLineBrush" Color="#A9C1F2" />
    <SolidColorBrush x:Key="ChipSelectedTextBrush" Color="#1D4CA8" />
    <SolidColorBrush x:Key="LinkBrush" Color="#2563D6" />
    <SolidColorBrush x:Key="LinkHoverBrush" Color="#1A4BAA" />
    <SolidColorBrush x:Key="GameTileBrush" Color="#FCE8DA" />
    <SolidColorBrush x:Key="GameTileTextBrush" Color="#B4561C" />
    <!-- Состояния -->
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#E5F5ED" />
    <SolidColorBrush x:Key="GoodLineBrush" Color="#B6E1CA" />
    <SolidColorBrush x:Key="GoodChipBrush" Color="#D6F0E2" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#156B47" />
    <SolidColorBrush x:Key="WarningChipBrush" Color="#F8EAD2" />
    <SolidColorBrush x:Key="CriticalChipBrush" Color="#F9DDDC" />
    <SolidColorBrush x:Key="GoodBrush" Color="#1E9E6A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#D63C37" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2B6BDF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#142B6BDF" />
    <SolidColorBrush x:Key="InfoLineBrush" Color="#452B6BDF" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1AB7791F" />
    <SolidColorBrush x:Key="WarningLineBrush" Color="#55B7791F" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#14D63C37" />
    <SolidColorBrush x:Key="CriticalLineBrush" Color="#50D63C37" />
    <!-- Затемнение под окнами поверх страницы -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66202226" />
</ResourceDictionary>
